node_modules/
dist/
dist-react/
.deploy/
.wrangler/
public/openpress/
.DS_Store
.antigravitycli/

# Turborepo build cache — pure local build artifact, never commit.
# Match at any depth (root .turbo/ + per-package packages/*/.turbo/).
.turbo

# The framework dogfood workspace lives in root press/ and IS tracked.
# packages/core/document/ was the old local scratch location and stays ignored.
/packages/core/document/

# Workspace project memory（per-project agent notes — deployment, naming, history）。
# 每個專案各自管，不 push 到 framework upstream。
memory/

# Internal superpowers notes / WIP specs。會在 framework repo 公開前下架。
/docs/superpowers/

__pycache__/
*.pyc
.pytest_cache/
.playwright-mcp/
test-results/
playwright-report/

# Reader E2E renders a disposable public site inside its fixture workspace.
# Keep it out of Changesets release commits after browser tests run in CI.
/packages/core/tests/fixtures/e2e-reader/public/

.openpress/previews/
.openpress/memory/
.openpress/tmp/
.openpress/cache/
.openpress/migrations/
*.log
*.pid
/tmp/
/dogfood-*.png
/packages/cli/dist/
/packages/cli/template/

# Astro landing site build output
/apps/web/dist/
/apps/web/.astro/
.claude/
.agents/
skills-lock.json

# Nested cache directories (packages/*/.openpress/, etc.)
**/.openpress/
