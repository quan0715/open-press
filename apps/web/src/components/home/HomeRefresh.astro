---
import ProductWorkbenchSection from "./ProductWorkbenchSection.astro";

const lang = Astro.currentLocale || "zh-tw";

const methodRows = {
  "zh-tw": [
    { label: "準備素材", title: "點子、大綱或來源資料夾", body: "從筆記、章節、截圖、數據或安裝好的創意技能開始。" },
    { label: "讓 Agent 塑造內容", title: "故事、章節與頁面元件", body: "Agent 將簡報轉化為 MDX、TSX 元件、主題設定檔與媒體選擇。" },
    { label: "使用 OpenPress 完成", title: "檢查、編輯、驗證與匯出", body: "OpenPress 保持原始碼的可編輯性，渲染出固定版面，並可輸出 PNG、PDF 或網頁閱讀器。" }
  ],
  en: [
    { label: "Bring the material", title: "Idea, brief, or source folder", body: "Start from notes, chapters, screenshots, data, or an installed creative skill." },
    { label: "Let the agent shape it", title: "Story, sections, and page components", body: "The agent turns the brief into MDX, TSX components, theme tokens, and media choices." },
    { label: "Use OpenPress to finish", title: "Inspect, edit, validate, export", body: "OpenPress keeps the source editable, renders fixed pages, and outputs PNG, PDF, or web readers." }
  ],
  ja: [
    { label: "素材を用意する", title: "アイデア、概要、ソースフォルダ", body: "ノート、章、スクリーンショット、データ、またはインストールされたクリエイティブスキルから始めます。" },
    { label: "エージェントに形作らせる", title: "ストーリー、セクション、ページコンポーネント", body: "エージェントは概要をMDX、TSXコンポーネント、テーマトークン、メディアの選択肢に変換します。" },
    { label: "OpenPressで仕上げる", title: "検査、編集、検証、エクスポート", body: "OpenPressはソースを編集可能に保ち、固定ページをレンダリングし、PNG、PDF、またはWebリーダーを出力します。" }
  ]
};

const contractRows = {
  "zh-tw": [
    ["以 Agent 為先", "您的程式 Agent 透過技能、提示詞與原始碼檔案來操作工作區。"],
    ["共享合約", "頁面、簡報、MDX 章節、主題、註解與輸出的通用基礎。"],
    ["人類可編輯", "檢查原始碼、調整文案、保持排版決策可見，然後重新渲染。"],
    ["沒有黑箱管線", "不要修補截圖或生成的 HTML；修正原始碼並透過 OpenPress 匯出。"]
  ],
  en: [
    ["Agent first", "Your coding agent operates the workspace from skills, prompts, and source files."],
    ["Shared contract", "A common base for pages, slides, MDX sections, themes, comments, and output."],
    ["Human editable", "Review source, adjust copy, keep layout decisions visible, then render again."],
    ["No shadow pipeline", "Do not patch screenshots or generated HTML; fix the source and export through OpenPress."]
  ],
  ja: [
    ["エージェントファースト", "コーディングエージェントは、スキル、プロンプト、ソースファイルからワークスペースを操作します。"],
    ["共有コントラクト", "ページ、スライド、MDXセクション、テーマ、コメント、および出力の共通ベース。"],
    ["人間が編集可能", "ソースをレビューし、コピーを調整し、レイアウトの決定を可視化したままにし、再度レンダリングします。"],
    ["シャドウパイプラインなし", "スクリーンショットや生成されたHTMLにパッチを当てないでください。ソースを修正し、OpenPressを通じてエクスポートしてください。"]
  ]
};

const outputWall = {
  image: "/outputs/dogfood-output-wall.png",
  alt: "Perspective wall of Page, Slide, and Buzz dogfood Press PNG exports",
};

const heroRotatingWords = {
  "zh-tw": ["出版物框架"],
  en: ["agents"],
  ja: ["出版フレームワーク"]
};
const openPressSkillCommand = "npx -y skills@latest add quan0715/open-press";

const ui = {
  "zh-tw": {
    heroEyebrow: "OpenPress 1.0 · Agent 優先的出版框架",
    heroTitleStart: "OpenPress",
    heroTitleMiddle: "專為 Agent 設計的",
    heroSrTitle: "OpenPress。專為 Agent 設計的出版物框架。",
    heroDesc: "帶上想法、大綱或素材資料夾。Agent 負責塑造內容；OpenPress 提供可檢查、可編輯、可重複輸出的出版工作區。",
    heroStartBtn: "開始使用技能",
    heroDocsBtn: "閱讀說明文件",
    startEyebrow: "Press 與 Docs",
    startTitle: "Docs 存文件。Press 組出版物。",
    startDesc: "Docs 適合保存一份文件；Press 把頁面順序、元件、主題與輸出規則放進同一個可編輯工作區。這就是 OpenPress 被稱為框架的原因：Agent 可以沿用同一套結構，從素材一路完成出版。",
    startBeginner: "兩種工作方式",
    startDocsTitle: "Docs",
    startDocsDesc: "保存文字與章節，適合單一文件。",
    startPressTitle: "Press",
    startPressDesc: "組織頁面、元件、主題與可重複輸出，適合一整套出版物。",
    startLink: "開啟快速入門",
    flowEyebrow: "運作方式",
    flowTitle: "從大綱到正式出版",
    flowDesc: "OpenPress 不是另一個創意技能。它是一個共享工作區，當文件需要真實頁面、版本控制與可重複輸出的格式時，所有技能都可以依賴它。",
    diffEyebrow: "框架如何工作",
    diffTitle: "讓 Agent 操作結構，不是堆出 HTML",
    diffDesc: "Docs 會把內容放進文件；Press 會把內容、頁面、元件與來源組成一棵可檢查的出版樹。OpenPress 將這套結構固定下來，讓 Agent 少處理重複的版面細節，把上下文留給內容與決策。",
    diffDocsContext: "Docs 內容",
    diffPressContext: "Press 結構",
    diffFrameworkContext: "共享框架",
    whyEyebrow: "為何存在",
    whyTitle: "一個核心標準",
    whyDesc: "開發者不斷在不同的工具中重建 HTML 轉文件、文件轉 PPT 或社群貼文的工作流。OpenPress 提供這些工作流一個共享且人類可編輯的基底。",
    sourceEyebrow: "人類協作",
    sourceTitle: "可讀的來源。渲染出的頁面。",
    sourceDesc: "Agent 編輯的是工作區，而不是最終截圖。註解、MDX 章節、本地元件與主題設定皆保持可見，確保人類能輕鬆審核並精細調整成果。",
    outputEyebrow: "輸出格式",
    outputTitle: "頁面 / 簡報 / 社群圖卡",
    outputDesc: "將一個可編輯的工作區，轉換成精美的頁面、簡報和社群準備好的視覺圖。將故事保留在原始碼中；並輸出您的受眾需要的格式。",
    agentEyebrow: "與 Agent 協作",
    agentTitle: "由技能提供品味。由 OpenPress 提供工作區。",
    agentDesc: "社群卡片技能、講義技能或論文技能負責選擇工作流與入門範例。OpenPress 提供底層的執行環境：工作區、固定頁面、原始碼、預覽、驗證與匯出。",
    agentLink: "閱讀 Agent 工作流",
  },
  en: {
    heroEyebrow: "OpenPress 1.0 · agent-first publication framework",
    heroTitleStart: "OpenPress",
    heroTitleMiddle: "A publication framework for",
    heroSrTitle: "OpenPress. A publication framework designed for agents.",
    heroDesc: "Bring an idea, a brief, or a source folder. Your agent shapes the content; OpenPress provides the workspace for inspectable, editable, repeatable publication output.",
    heroStartBtn: "Start with skills",
    heroDocsBtn: "Read docs",
    startEyebrow: "Press and Docs",
    startTitle: "Docs holds a document. Press builds a publication.",
    startDesc: "Docs is a good home for one document. A Press puts page order, components, themes, and output rules in one editable workspace. That shared structure is why OpenPress is a framework: an agent can reuse it from source material through publication.",
    startBeginner: "Two working models",
    startDocsTitle: "Docs",
    startDocsDesc: "Stores text and sections for a single document.",
    startPressTitle: "Press",
    startPressDesc: "Organizes pages, components, themes, and repeatable output for a complete publication.",
    startLink: "Open quick start",
    flowEyebrow: "How it works",
    flowTitle: "Brief to publication.",
    flowDesc: "OpenPress is not another creative skill. It is the shared workspace those skills can rely on when a document needs real pages, source control, and repeatable output.",
    diffEyebrow: "How the framework works",
    diffTitle: "Give the agent structure, not a pile of HTML.",
    diffDesc: "Docs holds content in a document. A Press organizes content, pages, components, and sources into an inspectable publication tree. OpenPress fixes that structure so the agent spends less context on repeated layout details and more on content and decisions.",
    diffDocsContext: "Docs context",
    diffPressContext: "Press structure",
    diffFrameworkContext: "Shared framework",
    whyEyebrow: "Why it exists",
    whyTitle: "One base contract.",
    whyDesc: "Developers are rebuilding HTML-to-doc, doc-to-PPT, and social-post flows in separate tools. OpenPress gives those flows a shared, human-editable workspace.",
    sourceEyebrow: "Human collaboration",
    sourceTitle: "Readable source. Rendered pages.",
    sourceDesc: "The agent edits the workspace, not the final screenshot. Comments, MDX chapters, local components, and theme tokens remain visible so a person can review and refine the result.",
    outputEyebrow: "Outputs",
    outputTitle: "Page / Slide / Buzz.",
    outputDesc: "Turn one editable workspace into polished pages, presentation slides, and social-ready visuals. Keep the story in source; export the format your audience needs.",
    agentEyebrow: "Work with Agent",
    agentTitle: "Taste from skills. Workspace from OpenPress.",
    agentDesc: "A social-card skill, lecture-note skill, or paper-writing skill can choose the workflow and starter examples. OpenPress supplies the runtime beneath them: workspace, fixed pages, sources, preview, validation, and export.",
    agentLink: "Read the agent workflow",
  },
  ja: {
    heroEyebrow: "OpenPress 1.0 · エージェント優先の出版フレームワーク",
    heroTitleStart: "OpenPress",
    heroTitleMiddle: "エージェントのための",
    heroSrTitle: "OpenPress。エージェントのために設計された出版フレームワーク。",
    heroDesc: "アイデア、概要、ソースフォルダーから始めてください。エージェントが内容を形作り、OpenPressが検査、編集、再現可能な出版のためのワークスペースを提供します。",
    heroStartBtn: "スキルから始める",
    heroDocsBtn: "ドキュメントを読む",
    startEyebrow: "PressとDocs",
    startTitle: "Docsは文書を保存し、Pressは出版物を組み立てます。",
    startDesc: "Docsは一つの文書を保存する場所です。Pressは、ページの順序、コンポーネント、テーマ、出力規則を一つの編集可能なワークスペースにまとめます。この共通構造があるからこそ、OpenPressはフレームワークとして機能します。エージェントは素材から出版まで同じ構造を再利用できます。",
    startBeginner: "2つの使い方",
    startDocsTitle: "Docs",
    startDocsDesc: "一つの文書のために、文章とセクションを保存します。",
    startPressTitle: "Press",
    startPressDesc: "出版物全体のページ、コンポーネント、テーマ、再現可能な出力をまとめます。",
    startLink: "クイックスタートを開く",
    flowEyebrow: "仕組み",
    flowTitle: "概要から出版まで。",
    flowDesc: "OpenPressは単なるクリエイティブスキルではありません。ドキュメントに実際のページ、ソース管理、繰り返し可能な出力が必要な場合に、これらのスキルが依存できる共有ワークスペースです。",
    diffEyebrow: "フレームワークの仕組み",
    diffTitle: "エージェントにHTMLの山ではなく構造を渡す。",
    diffDesc: "Docsは内容を一つの文書に置きます。Pressは内容、ページ、コンポーネント、ソースを検査可能な出版ツリーにまとめます。OpenPressはこの構造を固定し、エージェントが繰り返しのレイアウト詳細に使うコンテキストを減らし、内容と判断に集中できるようにします。",
    diffDocsContext: "Docsの内容",
    diffPressContext: "Pressの構造",
    diffFrameworkContext: "共有フレームワーク",
    whyEyebrow: "なぜ存在するのか",
    whyTitle: "1つの基本契約。",
    whyDesc: "開発者は、HTMLからドキュメント、ドキュメントからPPT、ソーシャル投稿のフローを別々のツールで再構築しています。OpenPressは、これらのフローに共有の、人間が編集可能なワークスペースを提供します。",
    sourceEyebrow: "人間とのコラボレーション",
    sourceTitle: "読みやすいソース。レンダリングされたページ。",
    sourceDesc: "エージェントは最終的なスクリーンショットではなく、ワークスペースを編集します。コメント、MDXの章、ローカルコンポーネント、テーマトークンは可視化されたままであるため、人間が結果をレビューし、調整することができます。",
    outputEyebrow: "出力形式",
    outputTitle: "ページ / スライド / バズ",
    outputDesc: "1つの編集可能なワークスペースを、洗練されたページ、プレゼンテーションスライド、ソーシャル向けビジュアルに変換します。ストーリーをソースに保持し、対象者が必要とする形式でエクスポートします。",
    agentEyebrow: "エージェントと協力する",
    agentTitle: "スキルからのセンス。OpenPressからのワークスペース。",
    agentDesc: "ソーシャルカードスキル、講義ノートスキル、または論文作成スキルは、ワークフローと入門例を選択できます。OpenPressは、その下のランタイム（ワークスペース、固定ページ、ソース、プレビュー、検証、エクスポート）を提供します。",
    agentLink: "エージェントワークフローを読む",
  }
};
const t = ui[lang as keyof typeof ui] || ui["zh-tw"];
const heroWords = heroRotatingWords[lang as keyof typeof heroRotatingWords] || heroRotatingWords["zh-tw"];
---

<section class="border-b border-hairline" aria-labelledby="home-title" data-home-hero>
  <div class="op-page flex min-h-[calc(100dvh-4.75rem)] flex-col py-[clamp(3rem,6vh,5rem)] max-[720px]:min-h-0 max-[720px]:py-12">
    <div class="flex max-w-[76rem] flex-col min-w-0">
      <p class="op-eyebrow">{t.heroEyebrow}</p>
      <h1
        id="home-title"
        class:list={[
          "max-w-none mt-6 font-bold leading-[0.92] tracking-[-0.045em] break-normal [overflow-wrap:normal] [hyphens:none] max-[720px]:mt-5 max-[720px]:text-[clamp(3.2rem,14vw,4.8rem)] max-[720px]:leading-[0.96]",
          lang === "zh-tw" && "text-[clamp(4.5rem,7.2vw,7.25rem)]",
          lang === "ja" && "text-[clamp(4.2rem,6.5vw,6.5rem)]",
          lang === "en" && "text-[clamp(4.5rem,7.8vw,8rem)]",
        ]}
      >
        <span class="block" aria-hidden="true">
          <span class="block">{t.heroTitleStart}</span>
          <span class="flex flex-wrap items-baseline gap-x-[0.22em]">
            <span>{t.heroTitleMiddle}</span>
            <span class="inline-grid min-w-[5.3ch] min-h-[1.04em] pb-[0.04em] text-accent italic">
              {heroWords.map((word, index) => (
                <span
                  class:list={[
                    "col-start-1 row-start-1",
                    heroWords.length > 1
                      ? "opacity-0 translate-y-[0.18em] animate-[hero-word-rotate_8s_var(--op-ease)_infinite]"
                      : "opacity-100",
                  ]}
                  style={heroWords.length > 1 ? `animation-delay: calc(${index} * 2s);` : undefined}
                >{word}</span>
              ))}
            </span>
          </span>
        </span>
        <span class="sr-only">{t.heroSrTitle}</span>
      </h1>
      <p class="max-w-[36rem] mt-6 text-subdued-strong text-[clamp(1rem,1.18vw,1.18rem)] leading-[1.55]">{t.heroDesc}</p>
      <div class="flex flex-wrap gap-3 mt-6" aria-label="Primary actions">
        <a class="inline-flex items-center justify-center min-h-[3rem] px-5 border border-hairline-strong rounded-md font-semibold !no-underline transition-all duration-fast ease hover:bg-[#333333] active:scale-[0.98] bg-ink-strong !text-ink-on-dark hover:!text-paper" href={`/${lang}/docs/getting-started`.replace('//', '/')}>{t.heroStartBtn}</a>
        <a class="inline-flex items-center justify-center min-h-[3rem] px-5 border border-hairline-strong rounded-md font-semibold !no-underline transition-all duration-fast ease hover:bg-paper-soft active:scale-[0.98] bg-paper !text-ink hover:!text-ink" href={`/${lang}/docs`.replace('//', '/')}>{t.heroDocsBtn}</a>
      </div>
    </div>

    <div class="mt-auto max-w-[48rem] pt-[clamp(3rem,8vh,6rem)]" data-hero-skill-command>
      <div class="flex min-w-0 items-center justify-between gap-3 border border-hairline-strong bg-surface p-[0.45rem_0.45rem_0.45rem_1.1rem] rounded-md shadow-[0_1rem_2.5rem_rgba(53,43,30,0.08)]">
        <code class="min-w-0 overflow-x-auto whitespace-nowrap text-ink text-[clamp(0.78rem,1.1vw,0.98rem)] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">{openPressSkillCommand}</code>
        <button class="flex-none border border-hairline-strong bg-surface px-4 py-[0.55rem] rounded-[4px] font-body text-xs font-semibold text-ink cursor-pointer transition-all duration-fast ease hover:bg-paper-soft hover:border-subdued active:scale-[0.96]" type="button" data-copy-command={openPressSkillCommand} aria-label="Copy OpenPress skill install command">Copy</button>
      </div>
    </div>
  </div>
</section>

<section class="py-16 bg-[color-mix(in_srgb,var(--op-paper-soft)_48%,var(--op-paper))] border-b border-hairline" id="start" aria-labelledby="start-title">
  <div class="op-page grid grid-cols-[minmax(0,0.7fr)_minmax(22rem,1fr)] gap-12 items-start max-[1080px]:grid-cols-1">
    <div>
      <p class="op-eyebrow">{t.startEyebrow}</p>
      <h2 id="start-title" class="mt-4 text-[clamp(2.7rem,6vw,5.2rem)] leading-[0.95] tracking-normal">{t.startTitle}</h2>
      <p class="mt-5 text-subdued-strong text-lg leading-[1.55]">{t.startDesc}</p>
    </div>

    <div class="border border-hairline-strong bg-surface p-6 rounded-md" aria-label={t.startBeginner}>
      <p class="text-accent font-mono text-xs tracking-wide uppercase">{t.startBeginner}</p>
      <div class="mt-6 grid grid-cols-2 gap-6 max-[720px]:grid-cols-1">
        <article>
          <strong class="block mb-2 text-xl text-ink-strong">{t.startDocsTitle}</strong>
          <span class="block text-subdued-strong leading-[1.5]">{t.startDocsDesc}</span>
        </article>
        <article>
          <strong class="block mb-2 text-xl text-ink-strong">{t.startPressTitle}</strong>
          <span class="block text-subdued-strong leading-[1.5]">{t.startPressDesc}</span>
        </article>
      </div>
      <a class="inline-flex items-center mt-8 font-semibold" href={`/${lang}/docs/getting-started`.replace('//', '/')}>{t.startLink}</a>
    </div>
  </div>
</section>

<section class="py-24 bg-ink-strong text-ink-on-dark max-[720px]:py-16" id="flow" aria-labelledby="flow-title">
  <div class="op-page grid grid-cols-1 gap-16 max-[1080px]:grid-cols-1">
    <div class="max-w-[56rem]">
      <p class="op-eyebrow text-subdued-on-dark">{t.flowEyebrow}</p>
      <h2 id="flow-title" class="mt-4 text-[clamp(2.7rem,6vw,5.2rem)] leading-[0.95] tracking-normal text-ink-on-dark">{t.flowTitle}</h2>
      <p class="mt-5 text-subdued-on-dark text-lg leading-[1.55]">{t.flowDesc}</p>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(18rem,1fr))] gap-8" aria-label="OpenPress workflow">
      {methodRows[lang as keyof typeof methodRows].map((row) => (
        <article class="flex flex-col gap-3 p-5 bg-[color-mix(in_srgb,var(--op-paper)_4%,transparent)] border border-hairline-strong rounded-md text-ink-on-dark">
          <p class="text-accent font-mono text-xs tracking-wide uppercase">{row.label}</p>
          <h3 class="text-2xl font-semibold text-[inherit]">{row.title}</h3>
          <span class="text-subdued-on-dark leading-[1.5]">{row.body}</span>
        </article>
      ))}
    </div>
  </div>
</section>

<ProductWorkbenchSection />

<section class="py-24 border-b border-hairline bg-surface max-[720px]:py-16" aria-labelledby="tree-title">
  <div class="op-page">
    <div class="max-w-[56rem]">
      <p class="op-eyebrow">{t.diffEyebrow}</p>
      <h2 id="tree-title" class="mt-4 text-[clamp(2.7rem,6vw,5.2rem)] leading-[0.95] tracking-normal">{t.diffTitle}</h2>
      <p class="mt-5 text-subdued-strong text-lg leading-[1.55]">{t.diffDesc}</p>
    </div>

    <div class="mt-12 grid grid-cols-3 gap-4 max-[1080px]:grid-cols-1" aria-label={t.diffFrameworkContext}>
      <div class="p-6 border border-hairline-strong bg-[color-mix(in_srgb,var(--op-paper)_50%,var(--op-surface))] rounded-md">
        <p class="text-[0.7rem] font-mono text-subdued-strong uppercase tracking-wide">{t.diffDocsContext}</p>
        <p class="mt-2 text-3xl font-bold font-mono text-ink-strong tracking-tight">14,200<span class="text-sm text-subdued font-normal tracking-normal"> tk / page</span></p>
      </div>
      <div class="p-6 border border-hairline-strong bg-[color-mix(in_srgb,var(--op-paper)_50%,var(--op-surface))] rounded-md">
        <p class="text-[0.7rem] font-mono text-ink-strong uppercase tracking-wide">{t.diffPressContext}</p>
        <p class="mt-2 text-3xl font-bold font-mono text-ink-strong tracking-tight">180<span class="text-sm text-subdued font-normal tracking-normal"> tk / page</span></p>
