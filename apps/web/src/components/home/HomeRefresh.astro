const openPressSkillCommand = "npx -y skills@latest add quan0715/open-press";
const agentPrompts = {
  "zh-tw": "請使用 OpenPress 建立一份出版物工作區。先執行 run dev 驗證頁面，再檢查來源、版面與輸出；不要直接匯出 PDF，先告訴我需要調整的地方。",
  en: "Create a publication workspace with OpenPress. Run dev to verify the pages first, then inspect the source, layout, and output. Do not export a PDF yet; tell me what needs to change.",
  ja: "OpenPressで出版物のワークスペースを作成してください。まずrun devでページを検証し、ソース、レイアウト、出力を確認してください。すぐにPDFへエクスポートせず、調整が必要な箇所を教えてください。",
