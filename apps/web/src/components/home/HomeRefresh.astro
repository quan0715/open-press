---
import ZineHeroSection from "./ZineHeroSection.astro";
import ZineHowItWorksSection from "./ZineHowItWorksSection.astro";
import ZineProposalSection from "./ZineProposalSection.astro";
import ZinePluginsSection from "./ZinePluginsSection.astro";
import ZineComparisonSection from "./ZineComparisonSection.astro";
import ZineInstallCta from "./ZineInstallCta.astro";
---

<div class="relative overflow-hidden">
  <ZineHeroSection />
  <ZineHowItWorksSection />
  <ZineComparisonSection />
  <ZineProposalSection />
  <ZinePluginsSection />
  <ZineInstallCta />
</div>

<script is:inline>
  document.querySelectorAll("[data-copy-install]").forEach((button) => {
    button.addEventListener("click", async () => {
      const command = button.getAttribute("data-command") ?? "";
      const label = button.querySelector("[data-copy-install-label]");
      try {
        await navigator.clipboard.writeText(command);
        if (label) label.textContent = button.getAttribute("data-copied") ?? "Copied";
        window.setTimeout(() => {
          if (label) label.textContent = button.getAttribute("data-label") ?? "Copy";
        }, 1600);
      } catch {
        if (label) label.textContent = button.getAttribute("data-label") ?? "Copy";
      }
    });
  });
</script>
