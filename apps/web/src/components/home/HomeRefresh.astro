const t = copy[lang as keyof typeof copy] || copy["zh-tw"];
---

<section class="overflow-hidden border-b border-hairline" aria-labelledby="home-title" data-home-hero>
  <div class="op-page grid min-h-[calc(100dvh-3.5rem)] grid-cols-12 items-center gap-x-8 gap-y-12 py-16 max-[900px]:grid-cols-1 max-[900px]:py-12">
    <div class="col-span-6 max-w-[42rem] max-[900px]:col-span-1">
      <p class="op-eyebrow">{t.eyebrow}</p>
      <h1 id="home-title" class="mt-6 text-[clamp(3.15rem,5.2vw,5.4rem)] font-medium leading-[0.96] tracking-[-0.055em] text-balance">
        <span class="block">{t.titleTop}</span>
        <span class="mt-1 block text-accent">{t.titleBottom}</span>
      </h1>
      <p class="mt-8 max-w-[34rem] text-[clamp(1.05rem,1.35vw,1.24rem)] leading-[1.62] text-subdued-strong text-pretty">{t.intro}</p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <button class="op-button op-button--primary" type="button" data-copy-install data-command={installCommand} data-label={t.copyInstall} data-copied={t.copied}>
          <span data-copy-install-label>{t.copyInstall}</span>
        </button>
        <a class="op-button op-button--quiet" href={showcaseUrl}>{t.viewExamples}</a>
      </div>
    </div>

    <div class="relative col-start-7 col-span-6 min-h-[36rem] max-[1100px]:col-start-6 max-[1100px]:col-span-7 max-[900px]:col-start-1 max-[900px]:col-span-1 max-[900px]:min-h-[32rem] max-[640px]:min-h-[24rem]" aria-label={t.galleryTitle}>
      <div class="absolute left-[2%] top-[8%] w-[43%] -rotate-[5deg] transition-transform duration-500 ease-out hover:-translate-y-2 hover:-rotate-[6deg]">
        <img class="op-paper-image" src={examples[0]?.cover} alt={examples[0]?.title} loading="eager" decoding="async" />
      </div>
      <div class="absolute right-[1%] top-[2%] z-[2] w-[45%] rotate-[4deg] transition-transform duration-500 ease-out hover:-translate-y-2 hover:rotate-[2deg]">
        <img class="op-paper-image" src={examples[2]?.cover} alt={examples[2]?.title} loading="eager" decoding="async" fetchpriority="high" />
      </div>
      <div class="absolute bottom-[1%] left-[28%] z-[3] w-[46%] rotate-[0.8deg] transition-transform duration-500 ease-out hover:-translate-y-2 hover:rotate-0">
        <img class="op-paper-image" src={examples[4]?.cover} alt={examples[4]?.title} loading="eager" decoding="async" />
      </div>
    </div>
  </div>
</section>

<section class="border-b border-hairline py-[clamp(5rem,9vw,8rem)]" aria-labelledby="gallery-title">
  <div class="op-page">
    <div class="max-w-[54rem]">
      <h2 id="gallery-title" class="text-[clamp(2.8rem,5.2vw,5rem)] font-medium leading-[0.98] tracking-[-0.045em] text-balance">{t.galleryTitle}</h2>
      <p class="mt-6 max-w-[43rem] text-lg leading-[1.62] text-subdued-strong text-pretty">{t.galleryIntro}</p>
    </div>

    <div class="op-document-grid mt-14">
      {examples.map((item) => (
        <a class="op-document-card group" href={`${showcaseUrl}#${item.slug}`}>
          <figure class="m-0">
            <div class="op-document-card__image">
              <img src={item.cover} alt={item.title} loading="lazy" decoding="async" />
            </div>
            <figcaption class="mt-4 grid gap-1">
              <strong class="font-body text-[clamp(1rem,1.4vw,1.2rem)] font-semibold leading-[1.25] text-ink-strong">{item.title}</strong>
              <span class="font-mono text-[0.7rem] text-subdued">{item.documentType} / {item.pageCount} {t.pages}</span>
            </figcaption>
          </figure>
        </a>
      ))}
    </div>

    <a class="op-text-link mt-10 inline-flex" href={showcaseUrl}>{t.allExamples}</a>
  </div>
</section>

<section class="border-b border-hairline py-[clamp(5rem,9vw,8rem)]" aria-labelledby="workflow-title">
  <div class="op-page grid grid-cols-12 items-start gap-x-10 gap-y-12 max-[900px]:grid-cols-1">
    <div class="col-span-7 max-[900px]:col-span-1">
      <div class="overflow-hidden border border-hairline-strong bg-surface shadow-[0_2rem_5rem_rgba(21,31,52,0.12)]">
        <img class="aspect-[8/5] w-full object-cover object-left-top" src="/product/workbench-document-editor.webp" alt="OpenPress workbench showing editable document source and page preview" loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="col-start-9 col-span-4 max-[900px]:col-start-1 max-[900px]:col-span-1">
      <h2 id="workflow-title" class="text-[clamp(2.5rem,4vw,4.4rem)] font-medium leading-[1] tracking-[-0.045em] text-balance">{t.workflowTitle}</h2>
      <p class="mt-5 max-w-[34rem] text-lg leading-[1.6] text-subdued-strong">{t.workflowIntro}</p>
      <ol class="mt-10 grid list-none gap-9 p-0">
        {t.workflow.map(([title, description]) => (
          <li class="grid grid-cols-[0.7rem_1fr] gap-4">
            <span class="mt-[0.55rem] h-2.5 w-2.5 bg-accent" aria-hidden="true"></span>
            <div>
              <h3 class="font-body text-xl font-semibold tracking-[-0.02em]">{title}</h3>
              <p class="mt-2 text-base leading-[1.58] text-subdued-strong">{description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<section class="border-b border-hairline py-[clamp(5rem,9vw,8rem)]" aria-labelledby="output-title">
  <div class="op-page">
    <div class="max-w-[57rem]">
      <h2 id="output-title" class="text-[clamp(2.8rem,5.2vw,5rem)] font-medium leading-[0.98] tracking-[-0.045em] text-balance">{t.outputTitle}</h2>
      <p class="mt-6 max-w-[46rem] text-lg leading-[1.62] text-subdued-strong">{t.outputIntro}</p>
    </div>

    <div class="mt-14 grid grid-cols-12 gap-8 max-[820px]:grid-cols-1">
      <div class="col-span-5 max-[820px]:col-span-1">
        <img class="op-paper-image w-full" src={examples[0]?.pages[1] || examples[0]?.cover} alt={examples[0]?.title} loading="lazy" decoding="async" />
      </div>
      <dl class="col-start-7 col-span-6 grid content-start gap-0 max-[820px]:col-start-1 max-[820px]:col-span-1">
        {t.outputs.map(([format, description]) => (
          <div class="grid grid-cols-[9rem_1fr] gap-6 border-b border-hairline py-8 first:border-t max-[560px]:grid-cols-1 max-[560px]:gap-2">
            <dt class="font-mono text-sm font-semibold text-accent">{format}</dt>
            <dd class="m-0 max-w-[35rem] text-[1.05rem] leading-[1.58] text-subdued-strong">{description}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<section class="py-[clamp(5rem,10vw,9rem)]" aria-labelledby="final-title">
  <div class="op-page">
    <div class="relative overflow-hidden border border-[color-mix(in_srgb,var(--op-accent)_34%,var(--op-hairline))] bg-[color-mix(in_srgb,var(--op-accent)_8%,var(--op-surface))] px-[clamp(1.5rem,5vw,5rem)] py-[clamp(3rem,7vw,6rem)]">
      <div class="relative z-[1] max-w-[52rem]">
        <h2 id="final-title" class="text-[clamp(2.8rem,5.2vw,5.4rem)] font-medium leading-[0.98] tracking-[-0.05em] text-balance">{t.finalTitle}</h2>
        <p class="mt-6 max-w-[43rem] text-lg leading-[1.62] text-subdued-strong">{t.finalIntro}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a class="op-button op-button--primary" href={`/${lang}/docs/getting-started`}>{t.docs}</a>
          <a class="op-button op-button--quiet" href="https://github.com/quan0715/open-press">{t.github}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll("[data-copy-install]").forEach((button) => {
    button.addEventListener("click", async () => {
      const command = button.getAttribute("data-command") ?? "";
      const label = button.querySelector("[data-copy-install-label]");
      try {
        await navigator.clipboard.writeText(command);
        if (label) label.textContent = button.getAttribute("data-copied") ?? "Copied";
        window.setTimeout(() => {
          if (label) label.textContent = button.getAttribute("data-label") ?? "Copy";
        }, 1600);
      } catch {
        if (label) label.textContent = button.getAttribute("data-label") ?? "Copy";
      }
    });
  });
</script>
