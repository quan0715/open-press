    { id: "school-report", title: "Dog Ownership\nConfidence & Companionship", label: "學校作業報告", caption: "根據老師的主題與你的想法與觀點編排出適合的作業內容", image: "/gallery/covers/school-report.png" },
    { id: "startup", title: "Content Workspace\nProduct Strategy and Go-to-Market Plan", label: "新創計劃書", caption: "從產品想法出發，完成一份可執行的市場與成長計劃", image: "/gallery/covers/startup-plan.png" },
