      ["Web Reader", "Publish the same document with browser reading and page navigation."],
    ],
    finalTitle: "Start with your next document.",
    finalIntro: "Install the OpenPress skill and let your agent create the first editable publication in your workspace.",
    docs: "Read installation docs",
    github: "Open GitHub",
  },
  ja: {
    eyebrow: "OpenPress ドキュメントフレームワーク",
    titleTop: "素材を整理して",
    titleBottom: "納品できる文書へ。",
    intro: "Agent が内容とレイアウトを整え、編集可能なソースから PDF、Word、公開リーダーを出力します。",
    copyInstall: "インストールコマンドをコピー",
    copied: "コピーしました",
    viewExamples: "文書例を見る",
