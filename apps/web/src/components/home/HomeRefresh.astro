---
import { getShowcases } from "../../data/showcases";
import WorkflowStorySection from "./WorkflowStorySection.astro";

const lang = Astro.currentLocale || "zh-tw";

const contractRows = {
  "zh-tw": [
    ["以 Agent 為先", "您的程式 Agent 透過技能、提示詞與原始碼檔案來操作工作區。"],
    ["文件工作區", "以 MDX 章節、主題、註解與固定版面組成可持續維護的文件。"],
    ["人類可編輯", "檢查原始碼、調整文案、保持排版決策可見，然後重新渲染。"],
    ["沒有黑箱管線", "不要修補截圖或生成的 HTML；修正原始碼並透過 OpenPress 匯出。"]
  ],
  en: [
    ["Agent first", "Your coding agent operates the workspace from skills, prompts, and source files."],
    ["Document workspace", "MDX sections, themes, comments, and fixed pages stay together as maintainable source."],
    ["Human editable", "Review source, adjust copy, keep layout decisions visible, then render again."],
    ["No shadow pipeline", "Do not patch screenshots or generated HTML; fix the source and export through OpenPress."]
  ],
  ja: [
    ["エージェントファースト", "コーディングエージェントは、スキル、プロンプト、ソースファイルからワークスペースを操作します。"],
    ["ドキュメントワークスペース", "MDXセクション、テーマ、コメント、固定ページを保守可能なソースとしてまとめます。"],
    ["人間が編集可能", "ソースをレビューし、コピーを調整し、レイアウトの決定を可視化したままにし、再度レンダリングします。"],
    ["シャドウパイプラインなし", "スクリーンショットや生成されたHTMLにパッチを当てないでください。ソースを修正し、OpenPressを通じてエクスポートしてください。"]
  ]
};

const outputRows = {
  "zh-tw": [
    ["PDF", "保留固定版面、字體與分頁，適合審閱、列印與正式交付。"],
    ["Word", "輸出可編輯 DOCX，交給需要傳統文件流程的協作者。"],
    ["Web Reader", "以公開閱讀器分享同一份文件，不另外維護網站版本。"],
  ],
  en: [
    ["PDF", "Preserve fixed pages, typography, and pagination for review, print, and delivery."],
    ["Word", "Export editable DOCX for collaborators who work in traditional document tools."],
    ["Web Reader", "Share the same publication in a browser without maintaining a separate site."],
  ],
  ja: [
    ["PDF", "固定レイアウト、書体、改ページを保ち、レビュー、印刷、納品に使用できます。"],
    ["Word", "従来の文書ツールを使う共同作業者向けに、編集可能なDOCXを出力します。"],
    ["Web Reader", "別のWebサイトを管理せず、同じ出版物をブラウザで共有します。"],
  ],
};

const heroRotatingWords = {
  "zh-tw": ["文件框架"],
  en: ["agents"],
  ja: ["ドキュメントフレームワーク"]
};
const composerPrompts = {
  "zh-tw": [
    "閱讀我的實驗數據幫我撰寫我的研究論文",
    "撰寫資料結構的課程筆記",
    "跟我一起討論並撰寫我的新創產品計劃書",
  ],
  en: [
    "Read my experiment data and help me write my research paper",
    "Write course notes for data structures",
    "Discuss and write my startup product plan with me",
  ],
  ja: [
    "実験データを読んで研究論文の執筆を手伝って",
    "データ構造の講義ノートを書いて",
    "新しいスタートアップの事業計画を一緒に考えて書いて",
  ],
};
const composerProviders = [
  { id: "gpt", label: "GPT", icon: "/provider-icons/openai.svg" },
  { id: "claude", label: "Claude", icon: "/provider-icons/claude.svg" },
  { id: "gemini", label: "Gemini", icon: "/provider-icons/gemini.svg" },
  { id: "cursor", label: "Cursor", icon: "/provider-icons/cursor.svg" },
  { id: "copilot", label: "Copilot", icon: "/provider-icons/copilot.svg" },
];
const openPressSkillCommand = "npx --yes skills@1.5.18 add quan0715/open-press --skill openpress openpress-apply-comments openpress-collaborate openpress-create-pages openpress-deploy openpress-upgrade --agent universal claude-code --yes";
const agentPrompts = {
  "zh-tw": "請使用 OpenPress 建立一份出版物工作區。先執行 run dev 驗證頁面，再檢查來源、版面與輸出；不要直接匯出 PDF，先告訴我需要調整的地方。",
  en: "Create a publication workspace with OpenPress. Run dev to verify the pages first, then inspect the source, layout, and output. Do not export a PDF yet; tell me what needs to change.",
  ja: "OpenPressで出版物のワークスペースを作成してください。まずrun devでページを検証し、ソース、レイアウト、出力を確認してください。すぐにPDFへエクスポートせず、調整が必要な箇所を教えてください。",
};

const ui = {
  "zh-tw": {
    heroEyebrow: "以 Agent 為先的文件框架",
    heroTitleMiddle: "專為 Agent 設計的",
    heroSrTitle: "專為 Agent 設計的文件框架。",
    heroDesc: "以內容為起點，讓 Agent 把想法、大綱或素材整理成可檢查、可編輯的正式文件。原始碼、版面、審閱紀錄與輸出留在同一個工作區。",
    promptForYou: "開始使用",
    promptForAgent: "交給 Agent",
    promptCopy: "Copy",
    promptCopyAgent: "Copy Prompt",
    promptAgentLabel: "Agent 提示詞已準備好，按下即可複製。",
    promptAgentReady: "Agent 提示詞已準備好",
    promptAudience: "提示詞使用對象",
    promptCopyCommandLabel: "複製 OpenPress 技能安裝指令",
    promptCopied: "已複製",
    demoLabel: "OpenPress Storybook・實際作品",
    demoReader: "線上閱讀器",
    composerTitle: "與任何 Agent 協作",
    composerPromptPreview: "Agent 提示詞預覽",
    composerAddContext: "新增內容",
    composerProvidersLabel: "可用的 AI Provider",
    composerSubmit: "送出",
    galleryTitle: "六份真實文件，直接看成品。",
    galleryDesc: "從兩頁履歷、五頁學校報告，到 158 頁課程筆記。每一份都由可編輯來源生成，點進去就能看完整頁面與使用的提示詞。",
    galleryLabel: "OpenPress 真實文件案例",
    galleryHint: "左右滑動瀏覽，點進案例查看完整頁面",
    galleryAll: "查看全部案例",
    galleryPrev: "上一個案例",
    galleryNext: "下一個案例",
    whyEyebrow: "為何存在",
    whyTitle: "一個核心標準",
    whyDesc: "正式文件經常散落在 Markdown、排版程式、PDF 與審閱工具之間。OpenPress 把內容、版面、修改與交付放進同一個人類可編輯的工作區。",
    outputEyebrow: "輸出格式",
    outputTitle: "PDF / Word / Web Reader",
    outputDesc: "同一份可編輯來源，依照協作與交付情境輸出成固定版面 PDF、可編輯 Word 或公開網頁閱讀器。",
  },
  en: {
    heroEyebrow: "Agent-first document framework",
    heroTitleMiddle: "A document framework built for",
    heroSrTitle: "A document framework built for agents.",
    heroDesc: "Start with content. Your agent turns an idea, brief, or source folder into an inspectable, editable workspace. There is no fixed template or single path, so you decide what to make and how it should take shape.",
    promptForYou: "Get started",
    promptForAgent: "Give it to Agent",
    promptCopy: "Copy",
    promptCopyAgent: "Copy Prompt",
    promptAgentLabel: "The agent prompt is ready to copy.",
    promptAgentReady: "Agent prompt ready",
    promptAudience: "Prompt audience",
    promptCopyCommandLabel: "Copy OpenPress skill install command",
    promptCopied: "Copied",
    demoLabel: "OpenPress Storybook · live demo",
    demoReader: "Live reader",
    composerTitle: "Work with any Agent",
    composerPromptPreview: "Agent prompt preview",
    composerAddContext: "Add context",
    composerProvidersLabel: "Available AI providers",
    composerSubmit: "Send",
    galleryTitle: "Six real documents. Start with the output.",
    galleryDesc: "From a two-page resume and a five-page school report to 158 pages of course notes. Every example comes from editable source, with the full pages and prompt ready to inspect.",
    galleryLabel: "Real OpenPress document examples",
    galleryHint: "Scroll sideways, then open a case to see the full pages",
    galleryAll: "View all examples",
    galleryPrev: "Previous example",
    galleryNext: "Next example",
    whyEyebrow: "Why it exists",
    whyTitle: "One base contract.",
    whyDesc: "Formal documents are often split across Markdown, layout code, PDFs, and review tools. OpenPress keeps content, layout, revision, and delivery in one human-editable workspace.",
    outputEyebrow: "Outputs",
    outputTitle: "PDF / Word / Web Reader",
    outputDesc: "Use one editable source to deliver fixed-layout PDF, editable Word, or a public web reader for the people who need the document.",
  },
  ja: {
    heroEyebrow: "エージェント優先のドキュメントフレームワーク",
    heroTitleMiddle: "エージェントのための",
    heroSrTitle: "エージェントのために設計されたドキュメントフレームワーク。",
    heroDesc: "内容から始めてください。エージェントがアイデア、概要、素材を、検査・編集できる正式な文書へ整理します。ソース、レイアウト、レビュー履歴、出力は同じワークスペースに残ります。",
    promptForYou: "はじめる",
    promptForAgent: "Agentに渡す",
    promptCopy: "Copy",
    promptCopyAgent: "Copy Prompt",
    promptAgentLabel: "エージェント用プロンプトをコピーできます。",
    promptAgentReady: "エージェント用プロンプトを準備しました",
    promptAudience: "プロンプトの対象",
    promptCopyCommandLabel: "OpenPressスキルのインストールコマンドをコピー",
    promptCopied: "コピーしました",
    demoLabel: "OpenPress Storybook・実際のデモ",
    demoReader: "オンラインリーダー",
    composerTitle: "どのAgentとも協働する",
    composerPromptPreview: "Agentプロンプトのプレビュー",
    composerAddContext: "コンテキストを追加",
    composerProvidersLabel: "利用できるAIプロバイダー",
    composerSubmit: "送信",
    galleryTitle: "6つの実文書。まず完成形を見る。",
    galleryDesc: "2ページの履歴書、5ページの学校レポート、158ページの講義ノートまで。すべて編集可能なソースから生成され、全ページとプロンプトを確認できます。",
    galleryLabel: "OpenPress の実際の文書例",
    galleryHint: "横にスクロールし、例を開いて文書全体を確認",
    galleryAll: "すべての例を見る",
    galleryPrev: "前の例",
    galleryNext: "次の例",
    whyEyebrow: "なぜ存在するのか",
    whyTitle: "1つの基本契約。",
    whyDesc: "正式な文書は、Markdown、レイアウトコード、PDF、レビューツールに分散しがちです。OpenPressは内容、レイアウト、修正、納品を、人間が編集できる一つのワークスペースにまとめます。",
    outputEyebrow: "出力形式",
    outputTitle: "PDF / Word / Web Reader",
    outputDesc: "一つの編集可能なソースから、固定レイアウトPDF、編集可能なWord、公開Webリーダーを用途に応じて出力します。",
  }
};
const t = ui[lang as keyof typeof ui] || ui["zh-tw"];
const heroWords = heroRotatingWords[lang as keyof typeof heroRotatingWords] || heroRotatingWords["zh-tw"];
const agentPrompt = agentPrompts[lang as keyof typeof agentPrompts] || agentPrompts["zh-tw"];
const activeGalleryItems = getShowcases(lang);
const activeOutputRows = outputRows[lang as keyof typeof outputRows] || outputRows["zh-tw"];
const dogfoodDemoUrl = "https://open-press-story.pages.dev/userstory/preview#page-01";
const activeComposerPrompts = composerPrompts[lang as keyof typeof composerPrompts] || composerPrompts["zh-tw"];
---

<section class="border-b border-hairline" aria-labelledby="home-title" data-home-hero>
  <div class="op-page grid grid-cols-12 pt-[clamp(4.5rem,8vh,7rem)] pb-[clamp(4rem,7vh,6.5rem)] max-[1080px]:grid-cols-1 max-[720px]:py-10">
    <div class="col-start-1 col-span-11 flex min-w-0 flex-col max-[1080px]:col-start-1 max-[1080px]:col-span-1">
      <p class="op-eyebrow">{t.heroEyebrow}</p>
      <h1
        id="home-title"
        class:list={[
          "max-w-none mt-8 font-light leading-[1.08] tracking-[-0.035em] break-normal [overflow-wrap:normal] [hyphens:none] max-[720px]:mt-6 max-[720px]:text-[clamp(3rem,12vw,4.3rem)] max-[720px]:leading-[1.08]",
          lang === "zh-tw" && "text-[clamp(4rem,6.5vw,6.5rem)]",
          lang === "ja" && "text-[clamp(3.9rem,6vw,5.9rem)]",
          lang === "en" && "text-[clamp(4rem,7vw,7.2rem)]",
        ]}
      >
        <span class="block" aria-hidden="true">
          <span class="flex flex-wrap items-baseline gap-x-[0.18em]">
            <span>{t.heroTitleMiddle}</span>
            <span
              class:list={[
                "inline-grid min-w-[5.3ch] min-h-[1.04em] pb-[0.04em] text-accent font-light",
                lang === "zh-tw" && "basis-full",
              ]}
            >
              {heroWords.map((word, index) => (
                <span
                  class:list={[
                    "col-start-1 row-start-1",
                    heroWords.length > 1
                      ? "opacity-0 translate-y-[0.18em] animate-[hero-word-rotate_8s_var(--op-ease)_infinite]"
                      : "opacity-100",
                  ]}
                  style={heroWords.length > 1 ? `animation-delay: calc(${index} * 2s);` : undefined}
                >{word}</span>
              ))}
            </span>
          </span>
        </span>
        <span class="sr-only">{t.heroSrTitle}</span>
      </h1>
      <p class="max-w-[48rem] mt-10 text-subdued-strong text-[clamp(1.08rem,1.32vw,1.28rem)] leading-[1.72]">{t.heroDesc}</p>
    </div>

    <div class="col-start-1 col-span-11 mt-20 max-w-[56rem] border-t border-hairline pt-8 max-[1080px]:col-start-1 max-[1080px]:col-span-1" data-hero-prompt>
      <div class="flex items-center gap-6 border-b border-hairline" role="tablist" aria-label={t.promptAudience}>
        <button class="border-b-2 border-ink-strong pb-3 pt-1 font-body text-sm font-medium text-ink-strong" type="button" role="tab" aria-selected="true" aria-controls="prompt-panel-you" data-prompt-tab="you">{t.promptForYou}</button>
        <button class="border-b-2 border-transparent pb-3 pt-1 font-body text-sm font-medium text-subdued transition-colors hover:text-ink-strong" type="button" role="tab" aria-selected="false" aria-controls="prompt-panel-agent" data-prompt-tab="agent">{t.promptForAgent}</button>
      </div>
      <div class="mt-7" data-prompt-panel="you" id="prompt-panel-you" role="tabpanel">
        <div class="flex min-h-[4rem] min-w-0 items-center justify-between gap-4 rounded-[0.85rem] border border-hairline-strong bg-surface p-2 pl-5 shadow-[0_1rem_2.5rem_rgba(53,43,30,0.08)] ring-1 ring-inset ring-[color-mix(in_srgb,var(--op-ink)_4%,transparent)] transition-[border-color,box-shadow] duration-fast ease hover:border-subdued hover:shadow-[0_1.25rem_3rem_rgba(53,43,30,0.1)]">
          <code class="min-w-0 overflow-x-auto whitespace-nowrap text-ink text-[clamp(0.9rem,1.2vw,1.08rem)] leading-[1.4] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">{openPressSkillCommand}</code>
          <button class="flex h-11 w-11 flex-none items-center justify-center rounded-[0.65rem] border border-hairline-strong bg-paper-soft text-ink cursor-pointer transition-[background,border-color,color,transform] duration-fast ease hover:border-ink-strong hover:bg-ink-surface hover:text-ink-on-dark active:scale-[0.94]" type="button" data-copy-command={openPressSkillCommand} data-copy-success-label={t.promptCopied} aria-label={t.promptCopyCommandLabel} title={t.promptCopy}>
            <svg class="h-5 w-5 fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" data-copy-icon viewBox="0 0 24 24" aria-hidden="true">
              <rect x="8" y="8" width="11" height="11" rx="1.5"></rect>
              <path d="M5 15V5h10"></path>
            </svg>
            <svg class="hidden h-5 w-5 fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" data-copy-check viewBox="0 0 24 24" aria-hidden="true">
              <path d="m5 13 4 4L19 7"></path>
            </svg>
          </button>
        </div>
      </div>
      <div class="mt-7" data-prompt-panel="agent" id="prompt-panel-agent" role="tabpanel" hidden>
        <div class="flex min-h-[4rem] min-w-0 items-center justify-between gap-4 rounded-[0.85rem] border border-hairline-strong bg-surface p-2 pl-5 shadow-[0_1rem_2.5rem_rgba(53,43,30,0.08)] ring-1 ring-inset ring-[color-mix(in_srgb,var(--op-ink)_4%,transparent)] transition-[border-color,box-shadow] duration-fast ease hover:border-subdued hover:shadow-[0_1.25rem_3rem_rgba(53,43,30,0.1)]">
          <span class="min-w-0 truncate text-subdued-strong text-[clamp(0.9rem,1.2vw,1.08rem)] leading-[1.4]">{t.promptAgentReady}</span>
          <button class="flex h-11 w-11 flex-none items-center justify-center rounded-[0.65rem] border border-hairline-strong bg-paper-soft text-ink cursor-pointer transition-[background,border-color,color,transform] duration-fast ease hover:border-ink-strong hover:bg-ink-surface hover:text-ink-on-dark active:scale-[0.94]" type="button" data-copy-prompt={agentPrompt} data-copy-success-label={t.promptCopied} aria-label={t.promptAgentLabel} title={t.promptCopyAgent}>
            <svg class="h-5 w-5 fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" data-copy-icon viewBox="0 0 24 24" aria-hidden="true">
              <rect x="8" y="8" width="11" height="11" rx="1.5"></rect>
              <path d="M5 15V5h10"></path>
            </svg>
            <svg class="hidden h-5 w-5 fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" data-copy-check viewBox="0 0 24 24" aria-hidden="true">
              <path d="m5 13 4 4L19 7"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="border-b border-hairline bg-[color-mix(in_srgb,var(--op-paper-soft)_48%,var(--op-paper))] py-24 max-[720px]:py-16" id="demo" aria-label={t.demoLabel} data-home-demo>
  <div class="op-page">
    <figure class="m-0 overflow-hidden rounded-md border border-hairline-strong bg-ink-surface shadow-[0_1.5rem_4rem_rgba(53,43,30,0.12)]">
      <figcaption class="flex min-h-12 items-center justify-between gap-4 border-b border-white/15 bg-ink-surface px-5 py-3 text-ink-on-dark max-[720px]:items-start max-[720px]:flex-col max-[720px]:gap-1">
        <span class="font-mono text-xs uppercase tracking-wide text-subdued-on-dark">{t.demoLabel}</span>
        <span class="font-mono text-xs uppercase tracking-wide text-subdued-on-dark">{t.demoReader}</span>
      </figcaption>
      <iframe
        src={dogfoodDemoUrl}
        title={t.demoLabel}
        loading="eager"
        allow="fullscreen"
        class="block h-[44rem] w-full border-0 bg-paper max-[1080px]:h-[38rem] max-[720px]:h-[30rem]"
      ></iframe>
    </figure>
  </div>
</section>

<section class="border-b border-[#2b2e32] bg-[#17191c] py-24 text-white max-[720px]:py-16" id="composer" aria-labelledby="composer-title" data-home-composer data-composer-prompts={JSON.stringify(activeComposerPrompts)}>
  <div class="op-page">
    <div class="mx-auto max-w-[58rem] text-center">
      <h2 id="composer-title" class="text-[clamp(2.7rem,6vw,5.2rem)] font-light leading-[0.98] tracking-[-0.035em] text-white">{t.composerTitle}</h2>
    </div>

    <div class="mx-auto mt-12 max-w-[58rem]" data-composer-shell>
      <div class="overflow-hidden rounded-[1.35rem] border border-white/20 bg-[#24272b] p-3 shadow-[0_1.75rem_4rem_rgba(0,0,0,0.28)]" data-composer-card>
        <div class="flex min-h-[11rem] items-start rounded-[1rem] border border-white/10 bg-[#1b1d20] px-6 py-6 text-left max-[720px]:min-h-[13rem] max-[720px]:px-5" role="textbox" aria-readonly="true" aria-label={t.composerPromptPreview} aria-live="polite">
          <div class="w-full font-mono text-[clamp(1.05rem,1.8vw,1.45rem)] leading-[1.7] tracking-[-0.02em] text-white">
            <span class="text-accent">/open-press</span><span class="px-[0.28em] text-white/45" aria-hidden="true"> </span><span data-composer-text></span><span class="ml-[0.12em] inline-block h-[1.15em] w-[0.08em] translate-y-[0.18em] bg-accent" data-composer-cursor aria-hidden="true"></span>
          </div>
        </div>
        <div class="flex min-h-14 items-center gap-2 px-2 pt-3 max-[720px]:flex-wrap">
          <button class="flex h-14 w-14 shrink-0 items-center justify-center rounded-[0.8rem] p-0 text-4xl font-light leading-none text-white/75 transition-[background,color,transform] duration-fast ease hover:bg-white/10 hover:text-white active:scale-[0.94]" type="button" aria-label={t.composerAddContext}>+</button>
          <div class="flex items-center gap-2 pl-1" aria-label={t.composerProvidersLabel}>
            {composerProviders.map((provider) => (
              <span class="group relative flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/5 transition-[background,border-color,transform] duration-fast ease hover:border-white/30 hover:bg-white/10 hover:-translate-y-px" title={provider.label}>
                <img class="h-[1.125rem] w-[1.125rem] object-contain" src={provider.icon} alt={provider.label} loading="lazy" decoding="async" />
              </span>
            ))}
          </div>
          <div class="flex-1"></div>
          <button class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-white p-0 text-2xl font-medium leading-none text-[#171717] transition-[background,color,transform] duration-fast ease hover:bg-accent hover:text-white active:scale-[0.94]" type="button" aria-label={t.composerSubmit}>↑</button>
        </div>
      </div>
    </div>

  </div>
</section>

<section class="border-b border-hairline bg-[color-mix(in_srgb,var(--op-paper-soft)_48%,var(--op-paper))] py-16 max-[720px]:py-12" id="start" aria-labelledby="start-title" data-cover-gallery>
  <div class="op-page">
    <div class="max-w-[64rem]">
