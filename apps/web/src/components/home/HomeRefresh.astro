---

<section class="border-b border-hairline" aria-labelledby="home-title" data-home-hero>
  <div class="op-page grid grid-cols-12 pt-[clamp(4.5rem,8vh,7rem)] pb-[clamp(4rem,7vh,6.5rem)] max-[1080px]:grid-cols-1 max-[720px]:py-10">
    <div class="col-start-1 col-span-11 flex min-w-0 flex-col max-[1080px]:col-start-1 max-[1080px]:col-span-1">
      <p class="op-eyebrow">{t.heroEyebrow}</p>
      <h1
        id="home-title"
        class:list={[
          "max-w-none mt-8 font-light leading-[1.08] tracking-[-0.035em] break-normal [overflow-wrap:normal] [hyphens:none] max-[720px]:mt-6 max-[720px]:text-[clamp(3rem,12vw,4.3rem)] max-[720px]:leading-[1.08]",
          lang === "zh-tw" && "text-[clamp(4rem,6.5vw,6.5rem)]",
          lang === "ja" && "text-[clamp(3.9rem,6vw,5.9rem)]",
          lang === "en" && "text-[clamp(4rem,7vw,7.2rem)]",
        ]}
      >
        <span class="block" aria-hidden="true">
          <span class="flex flex-wrap items-baseline gap-x-[0.18em]">
            <span>{t.heroTitleMiddle}</span>
            <span
              class:list={[
                "inline-grid min-w-[5.3ch] min-h-[1.04em] pb-[0.04em] text-accent font-light",
                lang === "zh-tw" && "basis-full",
              ]}
            >
              {heroWords.map((word, index) => (
                <span
                  class:list={[
                    "col-start-1 row-start-1",
                    heroWords.length > 1
                      ? "opacity-0 translate-y-[0.18em] animate-[hero-word-rotate_8s_var(--op-ease)_infinite]"
                      : "opacity-100",
                  ]}
                  style={heroWords.length > 1 ? `animation-delay: calc(${index} * 2s);` : undefined}
                >{word}</span>
              ))}
            </span>
          </span>
        </span>
