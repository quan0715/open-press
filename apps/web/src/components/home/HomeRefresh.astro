    allExamples: "查看全部案例",
    pages: "頁",
    workflowTitle: "Agent 做整理，你掌握文件。",
    workflowIntro: "從素材到成品，每一個決定都留在工作區裡。",
    workflow: [
      ["交付素材", "把筆記、數據、圖片與現有檔案放進專案，不必先整理成完美草稿。"],
      ["一起編輯", "Agent 編寫 MDX、調整版面並啟動預覽，你直接檢查來源與畫面。"],
      ["正式輸出", "同一份來源輸出 PDF、Word 與 Web Reader，不另外維護三套內容。"],
    ],
    outputTitle: "一份來源，三種正式交付。",
    outputIntro: "排版與內容保持一致，依照閱讀、協作或公開分享的情境選擇格式。",
    outputs: [
      ["PDF", "固定版面與分頁，適合列印、審閱與正式交付。"],
      ["Word", "輸出可編輯 DOCX，交給仍在傳統文件流程中的協作者。"],
      ["Web Reader", "直接公開同一份文件，保留閱讀器與頁面導航。"],
    ],
    finalTitle: "從下一份文件開始。",
    finalIntro: "安裝 OpenPress skill，讓 Agent 在你的工作區建立第一份可編輯出版物。",
    docs: "閱讀安裝文件",
    github: "前往 GitHub",
  },
  en: {
    eyebrow: "OpenPress document framework",
    titleTop: "Turn source material into",
    titleBottom: "documents people can use.",
    intro: "Your agent handles content and layout. You keep editable source and deliver PDF, Word, or a public reader.",
    copyInstall: "Copy install command",
    copied: "Copied",
    viewExamples: "View document examples",
    galleryTitle: "Start with the documents.",
    galleryIntro: "Resumes, school reports, annual reports, theses, and course notes all come from editable OpenPress projects.",
    allExamples: "View all examples",
    pages: "pages",
    workflowTitle: "Your agent organises. You stay in control.",
    workflowIntro: "Every decision remains visible in the workspace, from source material to final delivery.",
    workflow: [
      ["Bring the source", "Add notes, data, images, and existing files. They do not need to start as a polished draft."],
      ["Edit together", "Your agent writes MDX, adjusts layout, and starts preview while you review both source and pages."],
      ["Deliver the work", "Export PDF, Word, and a Web Reader from one source instead of maintaining three versions."],
    ],
    outputTitle: "One source. Three formal outputs.",
    outputIntro: "Keep content and layout consistent, then choose the format that fits review, collaboration, or public reading.",
    outputs: [
      ["PDF", "Fixed pages and pagination for print, review, and final delivery."],
