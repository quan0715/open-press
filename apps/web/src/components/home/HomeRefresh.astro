---
import { getShowcases } from "../../data/showcases";

const lang = Astro.currentLocale || "zh-tw";
const installCommand = "npx skills add quan0715/open-press";
const examples = getShowcases(lang);
const showcaseUrl = `/${lang}/showcase`;

const copy = {
  "zh-tw": {
