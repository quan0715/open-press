const heroWords = heroRotatingWords[lang as keyof typeof heroRotatingWords] || heroRotatingWords["zh-tw"];
const agentPrompt = agentPrompts[lang as keyof typeof agentPrompts] || agentPrompts["zh-tw"];
const activeGalleryItems = galleryItems[lang as keyof typeof galleryItems] || galleryItems["zh-tw"];
const dogfoodDemoUrl = "https://open-press-story.pages.dev/userstory/preview#page-01";
const activeComposerPrompts = composerPrompts[lang as keyof typeof composerPrompts] || composerPrompts["zh-tw"];
---

<section class="border-b border-hairline" aria-labelledby="home-title" data-home-hero>
  <div class="op-page grid grid-cols-12 pt-[clamp(4.5rem,8vh,7rem)] pb-[clamp(4rem,7vh,6.5rem)] max-[1080px]:grid-cols-1 max-[720px]:py-10">
    <div class="col-start-1 col-span-11 flex min-w-0 flex-col max-[1080px]:col-start-1 max-[1080px]:col-span-1">
      <p class="op-eyebrow">{t.heroEyebrow}</p>
      <h1
        id="home-title"
        class:list={[
          "max-w-none mt-8 font-light leading-[1.08] tracking-[-0.035em] break-normal [overflow-wrap:normal] [hyphens:none] max-[720px]:mt-6 max-[720px]:text-[clamp(3rem,12vw,4.3rem)] max-[720px]:leading-[1.08]",
          lang === "zh-tw" && "text-[clamp(4rem,6.5vw,6.5rem)]",
          lang === "ja" && "text-[clamp(3.9rem,6vw,5.9rem)]",
          lang === "en" && "text-[clamp(4rem,7vw,7.2rem)]",
        ]}
      >
        <span class="block" aria-hidden="true">
          <span class="flex flex-wrap items-baseline gap-x-[0.18em]">
            <span>{t.heroTitleMiddle}</span>
            <span
              class:list={[
                "inline-grid min-w-[5.3ch] min-h-[1.04em] pb-[0.04em] text-accent font-light",
                lang === "zh-tw" && "basis-full",
              ]}
            >
              {heroWords.map((word, index) => (
                <span
                  class:list={[
                    "col-start-1 row-start-1",
                    heroWords.length > 1
                      ? "opacity-0 translate-y-[0.18em] animate-[hero-word-rotate_8s_var(--op-ease)_infinite]"
                      : "opacity-100",
                  ]}
                  style={heroWords.length > 1 ? `animation-delay: calc(${index} * 2s);` : undefined}
                >{word}</span>
              ))}
            </span>
          </span>
        </span>
        <span class="sr-only">{t.heroSrTitle}</span>
      </h1>
      <p class="max-w-[48rem] mt-10 text-subdued-strong text-[clamp(1.08rem,1.32vw,1.28rem)] leading-[1.72]">{t.heroDesc}</p>
    </div>

    <div class="col-start-1 col-span-11 mt-20 max-w-[56rem] border-t border-hairline pt-8 max-[1080px]:col-start-1 max-[1080px]:col-span-1" data-hero-prompt>
      <div class="flex items-center gap-6 border-b border-hairline" role="tablist" aria-label={t.promptAudience}>
        <button class="border-b-2 border-ink-strong pb-3 pt-1 font-body text-sm font-medium text-ink-strong" type="button" role="tab" aria-selected="true" aria-controls="prompt-panel-you" data-prompt-tab="you">{t.promptForYou}</button>
        <button class="border-b-2 border-transparent pb-3 pt-1 font-body text-sm font-medium text-subdued transition-colors hover:text-ink-strong" type="button" role="tab" aria-selected="false" aria-controls="prompt-panel-agent" data-prompt-tab="agent">{t.promptForAgent}</button>
      </div>
      <div class="mt-7" data-prompt-panel="you" id="prompt-panel-you" role="tabpanel">
        <div class="flex min-h-[4rem] min-w-0 items-center justify-between gap-4 rounded-[0.85rem] border border-hairline-strong bg-surface p-2 pl-5 shadow-[0_1rem_2.5rem_rgba(53,43,30,0.08)] ring-1 ring-inset ring-[color-mix(in_srgb,var(--op-ink)_4%,transparent)] transition-[border-color,box-shadow] duration-fast ease hover:border-subdued hover:shadow-[0_1.25rem_3rem_rgba(53,43,30,0.1)]">
          <code class="min-w-0 overflow-x-auto whitespace-nowrap text-ink text-[clamp(0.9rem,1.2vw,1.08rem)] leading-[1.4] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">{openPressSkillCommand}</code>
          <button class="flex h-11 w-11 flex-none items-center justify-center rounded-[0.65rem] border border-hairline-strong bg-paper-soft text-ink cursor-pointer transition-[background,border-color,color,transform] duration-fast ease hover:border-ink-strong hover:bg-ink-surface hover:text-ink-on-dark active:scale-[0.94]" type="button" data-copy-command={openPressSkillCommand} data-copy-success-label={t.promptCopied} aria-label={t.promptCopyCommandLabel} title={t.promptCopy}>
            <svg class="h-5 w-5 fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" data-copy-icon viewBox="0 0 24 24" aria-hidden="true">
              <rect x="8" y="8" width="11" height="11" rx="1.5"></rect>
              <path d="M5 15V5h10"></path>
            </svg>
            <svg class="hidden h-5 w-5 fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" data-copy-check viewBox="0 0 24 24" aria-hidden="true">
              <path d="m5 13 4 4L19 7"></path>
            </svg>
          </button>
        </div>
      </div>
      <div class="mt-7" data-prompt-panel="agent" id="prompt-panel-agent" role="tabpanel" hidden>
        <div class="flex min-h-[4rem] min-w-0 items-center justify-between gap-4 rounded-[0.85rem] border border-hairline-strong bg-surface p-2 pl-5 shadow-[0_1rem_2.5rem_rgba(53,43,30,0.08)] ring-1 ring-inset ring-[color-mix(in_srgb,var(--op-ink)_4%,transparent)] transition-[border-color,box-shadow] duration-fast ease hover:border-subdued hover:shadow-[0_1.25rem_3rem_rgba(53,43,30,0.1)]">
          <span class="min-w-0 truncate text-subdued-strong text-[clamp(0.9rem,1.2vw,1.08rem)] leading-[1.4]">{t.promptAgentReady}</span>
          <button class="flex h-11 w-11 flex-none items-center justify-center rounded-[0.65rem] border border-hairline-strong bg-paper-soft text-ink cursor-pointer transition-[background,border-color,color,transform] duration-fast ease hover:border-ink-strong hover:bg-ink-surface hover:text-ink-on-dark active:scale-[0.94]" type="button" data-copy-prompt={agentPrompt} data-copy-success-label={t.promptCopied} aria-label={t.promptAgentLabel} title={t.promptCopyAgent}>
            <svg class="h-5 w-5 fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" data-copy-icon viewBox="0 0 24 24" aria-hidden="true">
              <rect x="8" y="8" width="11" height="11" rx="1.5"></rect>
              <path d="M5 15V5h10"></path>
            </svg>
            <svg class="hidden h-5 w-5 fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" data-copy-check viewBox="0 0 24 24" aria-hidden="true">
              <path d="m5 13 4 4L19 7"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

