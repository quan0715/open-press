    { id: "newspaper", title: "The News Today\nAgentic AI in the City", label: "新聞", caption: "讓事件、資料與觀點組成一張有脈絡的新聞版面", image: "/gallery/covers/newspaper.png" },
    { id: "invoice", title: "OpenPress Studio\nReceipt", label: "發票 Press", caption: "把付款、項目與交付整理成一張正式收據", image: "/gallery/covers/invoice.png" },
    { id: "contract", title: "Software Services\nAgreement", label: "甲乙方合約 Press", caption: "讓雙方條件與責任成為一份可簽署的合約", image: "/gallery/covers/contract.png" },
  ],
  en: [
    { id: "paper", title: "Urban Heat and Street Shade\nAn Observational Study", label: "Research paper", caption: "Shape research questions and evidence into a reviewable study", image: "/gallery/covers/paper.png" },
    { id: "school-report", title: "Dog Ownership\nConfidence & Companionship", label: "School assignment", caption: "Study how dogs support confidence and companionship", image: "/gallery/covers/school-report.png" },
    { id: "startup", title: "Content Workspace\nProduct Strategy and Go-to-Market Plan", label: "Startup plan", caption: "Shape product ideas and market input into an executable plan", image: "/gallery/covers/startup-plan.png" },
    { id: "notes", title: "Data Structures\nCourse Notes", label: "Study notes", caption: "Turn course themes and source material into study notes", image: "/gallery/covers/subject-notes.png" },
    { id: "magazine", title: "The New Collaborators\nA Magazine About Agentic AI", label: "Magazine", caption: "Turn reporting material and a point of view into a feature", image: "/gallery/covers/magazine.png" },
    { id: "newspaper", title: "The News Today\nAgentic AI in the City", label: "Newspaper", caption: "Turn events and evidence into a readable front page", image: "/gallery/covers/newspaper.png" },
    { id: "invoice", title: "OpenPress Studio\nReceipt", label: "Invoice Press", caption: "Record payment, line items, and delivery", image: "/gallery/covers/invoice.png" },
    { id: "contract", title: "Software Services\nAgreement", label: "Agreement Press", caption: "Turn shared terms and responsibilities into a signable agreement", image: "/gallery/covers/contract.png" },
  ],
  ja: [
    { id: "paper", title: "Urban Heat and Street Shade\nAn Observational Study", label: "論文", caption: "研究の問いと資料を検証できる内容へ", image: "/gallery/covers/paper.png" },
    { id: "school-report", title: "Dog Ownership\nConfidence & Companionship", label: "学校課題レポート", caption: "犬との暮らしが自信と寄り添いに与える影響を研究", image: "/gallery/covers/school-report.png" },
    { id: "startup", title: "Content Workspace\nProduct Strategy and Go-to-Market Plan", label: "新規事業計画書", caption: "プロダクトの考えと市場情報を実行できる計画へ", image: "/gallery/covers/startup-plan.png" },
    { id: "notes", title: "Data Structures\nCourse Notes", label: "学習ノート", caption: "授業のテーマと素材を読み返せるノートへ", image: "/gallery/covers/subject-notes.png" },
    { id: "magazine", title: "The New Collaborators\nA Magazine About Agentic AI", label: "雑誌", caption: "取材素材と視点を読める特集へ", image: "/gallery/covers/magazine.png" },
    { id: "newspaper", title: "The News Today\nAgentic AI in the City", label: "新聞", caption: "出来事と資料を読める紙面へ", image: "/gallery/covers/newspaper.png" },
    { id: "invoice", title: "OpenPress Studio\nReceipt", label: "請求書 Press", caption: "支払い、項目、納品を正式な領収書へ", image: "/gallery/covers/invoice.png" },
    { id: "contract", title: "Software Services\nAgreement", label: "甲乙間契約 Press", caption: "合意した条件と責任を明確な記録へ", image: "/gallery/covers/contract.png" },
