<section class="py-24 border-b border-hairline max-[720px]:py-16" id="workspace" aria-labelledby="workspace-title">
  <div class="op-page grid grid-cols-[minmax(0,0.7fr)_minmax(22rem,1fr)] gap-12 items-start max-[1080px]:grid-cols-1">
    <div class="max-w-[56rem]">
      <p class="op-eyebrow">{t.whyEyebrow}</p>
      <h2 id="workspace-title" class="mt-4 text-[clamp(2.7rem,6vw,5.2rem)] leading-[0.95] tracking-normal">{t.whyTitle}</h2>
      <p class="mt-5 text-subdued-strong text-lg leading-[1.55]">{t.whyDesc}</p>
    </div>

    <div class="flex flex-col">
      {contractRows[lang as keyof typeof contractRows].map(([label, value], i) => (
        <div class:list={["flex gap-6 py-4 border-b border-hairline-strong", i === 0 && "pt-0"]}>
          <strong class="flex-[0_0_10rem] text-ink-strong font-semibold max-[720px]:flex-[0_0_7rem]">{label}</strong>
          <p class="m-0 text-subdued-strong leading-[1.5]">{value}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="py-24 border-b border-hairline max-[720px]:py-16" id="output" aria-labelledby="output-title">
  <div class="op-page grid grid-cols-[minmax(0,0.45fr)_minmax(0,1fr)] gap-[clamp(2rem,6vw,6rem)] items-center max-[1080px]:grid-cols-1">
    <div class="max-w-[56rem]">
      <p class="op-eyebrow">{t.outputEyebrow}</p>
      <h2 id="output-title" class="mt-4 text-[clamp(2.7rem,6vw,5.2rem)] leading-[0.95] tracking-normal">{t.outputTitle}</h2>
      <p class="mt-5 text-subdued-strong text-lg leading-[1.55]">{t.outputDesc}</p>
    </div>

    <figure class="m-0" aria-label="Dogfood Press PNG output wall">
      <img class="block w-full h-auto max-[1080px]:aspect-[16/11]" src={outputWall.image} alt={outputWall.alt} loading="eager" decoding="async" />
    </figure>
  </div>
</section>

<script is:inline>
  document.addEventListener("click", async (event) => {
    const tab = event.target.closest("[data-prompt-tab]");
    if (tab) {
      const activeTab = tab.getAttribute("data-prompt-tab");
      document.querySelectorAll("[data-prompt-tab]").forEach((candidate) => {
        const isActive = candidate === tab;
        candidate.setAttribute("aria-selected", String(isActive));
        candidate.classList.toggle("border-ink-strong", isActive);
        candidate.classList.toggle("text-ink-strong", isActive);
        candidate.classList.toggle("border-transparent", !isActive);
        candidate.classList.toggle("text-subdued", !isActive);
      });
      document.querySelectorAll("[data-prompt-panel]").forEach((panel) => {
        panel.hidden = panel.getAttribute("data-prompt-panel") !== activeTab;
      });
      return;
    }

    const button = event.target.closest("[data-copy-command], [data-copy-prompt]");
    if (!button) return;

    const prompt = button.getAttribute("data-copy-command") ?? button.getAttribute("data-copy-prompt");
    if (!prompt) return;

    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(prompt);
      } else {
        throw new Error("Clipboard API unavailable");
      }
      const copyIcon = button.querySelector("[data-copy-icon]");
      const checkIcon = button.querySelector("[data-copy-check]");
      const originalLabel = button.getAttribute("aria-label") || "Copy";
      if (copyIcon) copyIcon.classList.add("hidden");
      if (checkIcon) checkIcon.classList.remove("hidden");
      button.setAttribute("aria-label", button.getAttribute("data-copy-success-label") || "Copied");
      window.setTimeout(() => {
        if (copyIcon) copyIcon.classList.remove("hidden");
        if (checkIcon) checkIcon.classList.add("hidden");
        button.setAttribute("aria-label", originalLabel);
      }, 1400);
    } catch {
      button.setAttribute("aria-label", "Select text to copy");
    }
  });

  const composer = document.querySelector("[data-home-composer]");
  if (composer) {
    const prompts = JSON.parse(composer.dataset.composerPrompts ?? "[]");
    const output = composer.querySelector("[data-composer-text]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let activeIndex = 0;
    let position = 0;
    let deleting = false;

    const render = () => {
      if (output) output.textContent = prompts[activeIndex]?.slice(0, position) ?? "";
    };

    const tick = () => {
      const prompt = prompts[activeIndex] ?? "";
      if (!deleting && position < prompt.length) {
        position += 1;
        render();
        window.setTimeout(tick, 48);
        return;
      }
      if (!deleting) {
        deleting = true;
        window.setTimeout(tick, 1700);
        return;
      }
      if (position > 0) {
        position -= 1;
        render();
        window.setTimeout(tick, 28);
        return;
      }
      deleting = false;
      activeIndex = (activeIndex + 1) % prompts.length;
      window.setTimeout(tick, 420);
    };

    if (prompts.length > 0) {
      if (reducedMotion.matches) {
        position = prompts[0].length;
        render();
      } else {
        render();
        window.setTimeout(tick, 420);
      }
    }
  }

  const coverCarousel = document.querySelector("[data-cover-carousel]");
  const coverTrack = coverCarousel?.querySelector("[data-cover-track]");
  const coverSlides = Array.from(coverCarousel?.querySelectorAll("[data-cover-slide]") ?? []);
  if (coverTrack && coverSlides.length > 0) {
    const gallerySection = coverCarousel.closest("[data-cover-gallery]");
    const landingNav = document.querySelector("[data-landing-nav]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let trackTarget = coverTrack.scrollLeft;
    let trackFrame = 0;
    let galleryIsExiting = false;
    let galleryExitTimer = 0;

    const getTrackMetrics = () => {
      const gap = Number.parseFloat(getComputedStyle(coverTrack).columnGap || "0");
      const amount = (coverSlides[0]?.getBoundingClientRect().width ?? 0) + gap;
      const maxScroll = Math.max(0, coverTrack.scrollWidth - coverTrack.clientWidth);
      return { amount, maxScroll };
    };

    const animateTrack = () => {
      if (reducedMotion.matches) {
        coverTrack.scrollLeft = trackTarget;
        trackFrame = 0;
        return;
      }

      const distance = trackTarget - coverTrack.scrollLeft;
      if (Math.abs(distance) < 0.5) {
        coverTrack.scrollLeft = trackTarget;
        trackFrame = 0;
        return;
      }

      coverTrack.scrollLeft += distance * 0.22;
      trackFrame = window.requestAnimationFrame(animateTrack);
    };

    const moveTrack = (delta) => {
      const { maxScroll } = getTrackMetrics();
      trackTarget = Math.max(0, Math.min(maxScroll, trackTarget + delta));
      if (!trackFrame) trackFrame = window.requestAnimationFrame(animateTrack);
    };

    const scrollByCover = (direction) => {
      const { amount } = getTrackMetrics();
      moveTrack(direction * amount);
    };

    const setVerticalLock = (locked) => {
      document.documentElement.toggleAttribute("data-cover-scroll-lock", locked);
      gallerySection?.toggleAttribute("data-cover-gallery-active", locked);
    };

    const releaseToNextSection = () => {
      const nextSection = gallerySection?.nextElementSibling;
      if (!(nextSection instanceof HTMLElement)) {
        setVerticalLock(false);
        return;
      }

      const navHeight = landingNav?.getBoundingClientRect().height ?? 56;
      const nextTop = nextSection.getBoundingClientRect().top + window.scrollY - navHeight;
      galleryIsExiting = true;
      setVerticalLock(true);
      document.documentElement.setAttribute("data-cover-gallery-exiting", "true");
      gallerySection?.setAttribute("data-cover-gallery-exiting", "true");
      window.scrollTo({ top: Math.max(0, nextTop), behavior: reducedMotion.matches ? "auto" : "smooth" });

      window.clearTimeout(galleryExitTimer);
      galleryExitTimer = window.setTimeout(() => {
        galleryIsExiting = false;
        setVerticalLock(false);
        document.documentElement.removeAttribute("data-cover-gallery-exiting");
        gallerySection?.removeAttribute("data-cover-gallery-exiting");
      }, reducedMotion.matches ? 0 : 720);
    };

    coverCarousel.querySelector("[data-cover-prev]")?.addEventListener("click", () => {
      scrollByCover(-1);
    });
    coverCarousel.querySelector("[data-cover-next]")?.addEventListener("click", () => {
      scrollByCover(1);
    });

    window.addEventListener("wheel", (event) => {
      if (!gallerySection) return;

      if (window.matchMedia("(max-width: 960px)").matches) {
        setVerticalLock(false);
        return;
      }

      if (galleryIsExiting) {
        event.preventDefault();
        event.stopPropagation();
        return;
      }

      const delta = Math.abs(event.deltaY) >= Math.abs(event.deltaX) ? event.deltaY : event.deltaX;
      if (!delta) return;

      const navHeight = landingNav?.getBoundingClientRect().height ?? 56;
      const bounds = gallerySection.getBoundingClientRect();
      const distanceToHeader = bounds.top - navHeight;
      const sectionIsBelowHeader = distanceToHeader > 1;
      const sectionIsPastViewport = bounds.bottom <= navHeight;
      const canSnapIntoGallery = delta > 0 && sectionIsBelowHeader && distanceToHeader <= Math.abs(delta);
      if (sectionIsPastViewport || (sectionIsBelowHeader && !canSnapIntoGallery)) {
        setVerticalLock(false);
        return;
      }

      if (canSnapIntoGallery) {
        event.preventDefault();
        event.stopPropagation();
        window.scrollTo(0, window.scrollY + distanceToHeader);
      }

      const { maxScroll } = getTrackMetrics();
      const atStart = trackTarget <= 1 && coverTrack.scrollLeft <= 1;
      const atEnd = trackTarget >= maxScroll - 1 && coverTrack.scrollLeft >= maxScroll - 1;
      const movingIntoGallery = delta > 0 && !atEnd;
      const movingBackIntoGallery = delta < 0 && !atStart;
      if (!movingIntoGallery && !movingBackIntoGallery) {
        if (delta > 0 && atEnd) {
          event.preventDefault();
          event.stopPropagation();
          releaseToNextSection();
          return;
        }

        setVerticalLock(false);
        return;
      }

      event.preventDefault();
      event.stopPropagation();
      setVerticalLock(true);
      moveTrack(delta);
    }, { capture: true, passive: false });

    coverTrack.addEventListener("scroll", () => {
      if (!trackFrame) trackTarget = coverTrack.scrollLeft;
    }, { passive: true });

    coverTrack.addEventListener("pointerdown", () => {
      if (!trackFrame) return;
      window.cancelAnimationFrame(trackFrame);
      trackFrame = 0;
      trackTarget = coverTrack.scrollLeft;
    }, { passive: true });
  }

  const codeWindows = Array.from(document.querySelectorAll("[data-code-reveal]"));
  if (codeWindows.length > 0) {
    const revealCodeWindow = (codeWindow) => {
      window.requestAnimationFrame(() => {
        codeWindow.classList.add("is-visible");
      });
    };

    if ("IntersectionObserver" in window) {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            revealCodeWindow(entry.target);
            revealObserver.unobserve(entry.target);
          }
        },
        { threshold: 0.24 },
      );

      for (const codeWindow of codeWindows) {
        revealObserver.observe(codeWindow);
      }
    } else {
      const revealVisibleCodeWindows = () => {
        for (const codeWindow of codeWindows) {
          if (codeWindow.classList.contains("is-visible")) continue;
          const box = codeWindow.getBoundingClientRect();
          if (box.top < window.innerHeight * 0.82 && box.bottom > 0) {
            revealCodeWindow(codeWindow);
          }
        }
      };

      window.addEventListener("scroll", revealVisibleCodeWindows, { passive: true });
      window.addEventListener("resize", revealVisibleCodeWindows);
      revealVisibleCodeWindows();
    }

    window.setTimeout(() => {
      for (const codeWindow of codeWindows) {
        if (!codeWindow.classList.contains("is-visible")) {
          revealCodeWindow(codeWindow);
        }
      }
    }, 1800);
  }
</script>

<style>
  html[data-cover-scroll-lock] {
    overscroll-behavior-y: none;
  }

  [data-cover-gallery][data-cover-gallery-exiting] > .op-page {
    opacity: 0.82;
    transform: translateY(-0.75rem);
    transition: opacity 480ms var(--op-ease), transform 480ms var(--op-ease);
  }

  html[data-cover-gallery-exiting] [data-cover-gallery-next] {
    animation: cover-gallery-next-enter 720ms var(--op-ease) both;
  }

  @keyframes cover-gallery-next-enter {
    from {
      opacity: 0.72;
      transform: translateY(1.5rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  [data-composer-cursor] {
    animation: composer-cursor 1s steps(1, end) infinite;
  }

  @keyframes composer-cursor {
    0%, 48% {
      opacity: 1;
    }

    49%, 100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-composer-cursor] {
      animation: none;
    }

    [data-cover-gallery][data-cover-gallery-exiting] > .op-page {
      opacity: 1;
      transform: none;
      transition: none;
    }

    html[data-cover-gallery-exiting] [data-cover-gallery-next] {
      animation: none;
    }
  }
</style>
