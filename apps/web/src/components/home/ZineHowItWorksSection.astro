    subtitle: "四個步驟，從 IDE 對話到高質感正式交付，每一個環節都由你與 Agent 協同完成。",
    steps: [
      {
        num: "01",
        name: "安裝 Agent 出版技能",
        summary: "一行指令，讓 AI 具備專業出版排版能力",
        desc: "在你的專案終端執行安裝指令。你的 AI 智能體（Cursor、Claude Code、Antigravity、Windsurf）立即載入 OpenPress 出版規範與排版工具鏈。",
        terminal: "npx skills add quan0715/open-press",
        roleTag: "你 / 終端機",
      },
      {
        num: "02",
        name: "丟入素材並下達出版指令",
        summary: "無需預先整理草稿，直接在聊天視窗溝通",
        desc: "把筆記、數據、圖片放進工作區，直接在 IDE 對話框中告訴 Agent：「請幫我把這些素材整理成一份 6 頁的技術白皮書，包含架構圖與章節導航」。",
        chatPrompt: "「@openpress 請把這份產品草稿整理成 6 頁白皮書，第 2 頁加入系統架構圖」",
        roleTag: "AI 智能體對話",
      },
      {
        num: "03",
        name: "即時雙向預覽與提案審閱",
        summary: "左側原始碼，右側 100% 紙張實體畫面",
        desc: "啟動本地工作台（Workbench），右側即時呈現精確分頁的紙張預覽。Agent 提出任何內容修改時，皆以安全沙盒 Proposal 呈現，由你比對 Diff 並確認套用。",
        terminal: "npm run dev:workspace",
        roleTag: "OpenPress Workbench",
      },
      {
        num: "04",
        name: "一體出版，多格式正式交付",
        summary: "不跑版、無溢出，同一份來源輸出三種成品",
        desc: "排版確認後，一鍵導出具備印刷品質的固定版面 PDF、可交付給傳統協作者的 Word DOCX，或直接發布為線上翻頁 Web 閱讀器。",
        terminal: "npm run openpress:pdf",
        roleTag: "正式交付",
      },
    ],
  },
  en: {
    badge: "HOW IT WORKS",
    seal: "OP",
    title: "How OpenPress Actually Works",
    subtitle: "Four concrete steps from IDE conversation to print-ready delivery, seamlessly collaborating with your AI agent.",
    steps: [
      {
        num: "01",
        name: "Install Agent Publishing Skill",
        summary: "One command equips your AI with publication design rules",
        desc: "Run the install command in your project terminal. Your AI agent (Cursor, Claude Code, Antigravity, Windsurf) immediately loads OpenPress layout conventions and tools.",
        terminal: "npx skills add quan0715/open-press",
        roleTag: "Terminal",
      },
      {
        num: "02",
        name: "Provide Material & Prompt Your Agent",
        summary: "No pre-formatting needed — talk directly in IDE chat",
        desc: "Drop raw notes, data, or images into your workspace, and prompt your agent: 'Organize this material into a 6-page technical whitepaper with architecture diagrams.'",
        chatPrompt: "'@openpress Turn these draft notes into a 6-page whitepaper with diagrams on page 2'",
        roleTag: "AI Chat",
      },
      {
        num: "03",
        name: "Live Workbench Preview & Proposals",
        summary: "Editable source on the left, 100% paper fidelity on the right",
        desc: "Boot the local Workbench to see fixed-page pagination in real time. When your agent proposes edits, review changes in a safe proposal sandbox before applying.",
        terminal: "npm run dev:workspace",
        roleTag: "Workbench",
      },
      {
        num: "04",
        name: "Export Multi-Format Deliverables",
        summary: "Zero overflow, zero layout shift — three formal formats",
        desc: "Export print-ready PDF with exact pagination, DOCX for traditional stakeholders, or publish directly to Cloudflare Pages as an interactive Web Reader.",
