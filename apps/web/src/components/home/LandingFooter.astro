---
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  version?: string;
}

const locale = Astro.currentLocale || "zh-tw";
const docsUrl = getRelativeLocaleUrl(locale, "docs");
const footerCopy = {
  "zh-tw": {
    description: "開源文件框架，讓 Agent 建立可以閱讀、編輯與交付的出版物。",
    showcase: "展示",
    docs: "文件",
    navigation: "頁尾導覽",
  },
  en: {
    description: "Open-source document framework for agent-built publications.",
    showcase: "Showcase",
    docs: "Docs",
    navigation: "Footer navigation",
  },
  ja: {
    description: "Agent と、読めて編集できる出版物を作るオープンソース文書フレームワーク。",
    showcase: "展示",
    docs: "文書",
    navigation: "フッターナビゲーション",
  },
} as const;
const t = footerCopy[locale as keyof typeof footerCopy] ?? footerCopy["zh-tw"];
---

<footer class="relative border-t border-hairline py-12 bg-paper/50">
  <div class="op-page grid grid-cols-[1fr_auto] items-end gap-8 max-[720px]:grid-cols-1 max-[720px]:items-start">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span class="op-seal-stamp h-4 w-4 text-[9px] font-bold">壓</span>
        <span class="font-display text-xl font-semibold tracking-[-0.025em] text-ink-strong">OpenPress</span>
      </div>
      <p class="max-w-[32rem] text-sm leading-[1.5] text-subdued-strong">{t.description}</p>
    </div>
    <div class="grid justify-items-end gap-4 max-[720px]:justify-items-start">
      <nav class="flex flex-wrap justify-end gap-x-5 gap-y-2 text-sm max-[720px]:justify-start" aria-label={t.navigation}>
        <a class="text-ink no-underline hover:text-accent" href={docsUrl}>{t.docs}</a>
        <a class="text-ink no-underline hover:text-accent" href="https://github.com/quan0715/open-press" target="_blank" rel="noreferrer noopener">GitHub</a>
        <a class="text-ink no-underline hover:text-accent" href="https://www.npmjs.com/package/@open-press/cli" target="_blank" rel="noreferrer noopener">npm</a>
      </nav>
      <p class="font-mono text-[0.7rem] text-subdued">COLOPHON / MIT LICENSE / 2026</p>
    </div>
  </div>
</footer>
