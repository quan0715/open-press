---
const lang = Astro.currentLocale || "zh-tw";

const copy = {
  "zh-tw": {
    badge: "MODULAR ECOSYSTEM",
    seal: "擴",
    title: "外掛生態：按需擴充專業能力。",
    intro: "OpenPress 核心專注於排版與分頁，特定領域的創作工具透過外掛生態按需引入，在 MDX 中直接調用。",
    codeBadge: "MDX 直接調用",
    adapterBadge: "OFFICIAL ADAPTER",
    plugins: [
      {
        tag: "VISUAL / ARCHITECTURE",
        name: "diagram-design",
        desc: "以乾淨的 SVG 與 React 元件繪製架構圖、系統時序圖、流程圖與基礎架構拓撲，自動適配紙張寬度與列印解析度。",
        code: "<ArchitectureDiagram type='system' />",
        author: "cathrynlavery/diagram-design",
        triggers: "架構圖 · 流程圖 · 循序圖 · 系統圖",
      },
      {
        tag: "EDITORIAL / COVER",
        name: "gc-minimal-zine-poster",
        desc: "紙質紋理、3:5 海報比例、印章徽章與極簡 Zine 刊物封面美學，為正式報告與白皮書打造專屬視覺開場。",
        code: "<ZineCover title='Annual Report 2026' />",
        author: "LiamGvchi/gc-minimal-zine-poster",
        triggers: "封面設計 · 海報 · 刊物封面 · 雜誌風",
      },
    ],
    customPluginTitle: "支援自訂外掛 (Custom Skills)",
    customPluginDesc: "任何遵循 open-press adapter 規範的外部專用 skill 皆可透過 CLI 擴充，將成果渲染為可版本控制的 React 元件或 MDX 內容。",
  },
  en: {
    badge: "MODULAR ECOSYSTEM",
    seal: "PL",
    title: "Plugin Ecosystem: On-Demand Capabilities.",
    intro: "OpenPress core stays focused on layout and pagination. Domain-specific tooling extends via modular plugins invoked directly in MDX.",
    codeBadge: "Directly in MDX",
    adapterBadge: "OFFICIAL ADAPTER",
    plugins: [
      {
        tag: "VISUAL / ARCHITECTURE",
        name: "diagram-design",
        desc: "Render sharp SVG & React architecture diagrams, sequence flows, and infrastructure topologies fitted to page constraints.",
        code: "<ArchitectureDiagram type='system' />",
        author: "cathrynlavery/diagram-design",
        triggers: "Architecture · Flowchart · Sequence · Topology",
      },
      {
        tag: "EDITORIAL / COVER",
        name: "gc-minimal-zine-poster",
        desc: "Paper textures, 3:5 poster ratios, seal stamp badges, and quiet Zine-style publication covers for formal reports.",
        code: "<ZineCover title='Annual Report 2026' />",
        author: "LiamGvchi/gc-minimal-zine-poster",
        triggers: "Cover Design · Poster · Zine · Editorial Art",
      },
    ],
    customPluginTitle: "Custom Skills & Adapters",
    customPluginDesc: "Any external skill complying with open-press adapter protocols can be registered via CLI, rendering as version-controlled React components or MDX.",
  },
  ja: {
    badge: "MODULAR ECOSYSTEM",
    seal: "拡",
    title: "プラグインエコシステム：必要な能力をオンデマンドで拡張。",
    intro: "OpenPress コアは組版と改ページに集中。専門分野の描画ツールはプラグイン経由で MDX 内に直接インポートして利用します。",
    codeBadge: "MDX から直接呼び出し",
    adapterBadge: "公式アダプター",
    plugins: [
      {
        tag: "VISUAL / ARCHITECTURE",
        name: "diagram-design",
        desc: "SVG と React で描画するクリーンなシステム構成図やフローチャート。ページ幅と印刷解像度に自動適応。",
        code: "<ArchitectureDiagram type='system' />",
        author: "cathrynlavery/diagram-design",
        triggers: "構成図 · フローチャート · シーケンス図 · 系統図",
      },
      {
        tag: "EDITORIAL / COVER",
        name: "gc-minimal-zine-poster",
        desc: "紙質テクスチャ、3:5 ポスター比率、朱印章、落ち着いた Zine 風の出版物カバー美学。",
        code: "<ZineCover title='Annual Report 2026' />",
        author: "LiamGvchi/gc-minimal-zine-poster",
        triggers: "表紙デザイン · ポスター · 刊行物カバー · Zine",
      },
    ],
    customPluginTitle: "カスタムスキルの追加",
    customPluginDesc: "open-press アダプター仕様に準拠した外部専用 skill を CLI で追加し、Git 管理可能な React 元件や MDX として出力できます。",
  },
} as const;

const t = copy[lang as keyof typeof copy] || copy["zh-tw"];
---

<section class="relative border-b border-hairline py-20 lg:py-28" aria-labelledby="plugins-title">
  {/* Registration cross marks */}
  <div class="pointer-events-none absolute left-6 top-6 font-mono text-xs text-subdued/40 select-none max-sm:hidden">+ 04.00</div>
  <div class="pointer-events-none absolute right-6 top-6 font-mono text-xs text-subdued/40 select-none max-sm:hidden">+ 96.00</div>

  <div class="op-page">
    <div class="max-w-[48rem]">
      <div class="flex items-center gap-2 text-accent font-mono text-xs uppercase tracking-widest">
        <span class="op-seal-stamp h-4 w-4 text-[9px] font-bold">{t.seal}</span>
        <span>{t.badge}</span>
      </div>
      <h2 id="plugins-title" class="mt-4 font-display text-[clamp(2.4rem,4.4vw,4.2rem)] font-medium leading-[1.02] tracking-[-0.04em] text-ink-strong">
        {t.title}
      </h2>
      <p class="mt-4 text-base lg:text-lg leading-[1.65] text-subdued-strong">
        {t.intro}
      </p>
    </div>

    {/* 2 Official Plugin Cards */}
    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-8">
      {t.plugins.map((plugin) => (
        <div class="rounded-xl border border-hairline-strong bg-surface p-7 shadow-[0_12px_36px_rgba(22,23,26,0.04)] flex flex-col justify-between relative overflow-hidden group hover:border-accent/50 transition-colors">
          <div>
            <div class="flex items-center justify-between border-b border-hairline pb-4">
              <span class="font-mono text-xs font-bold text-accent uppercase tracking-wider">
                {plugin.tag}
              </span>
              <span class="rounded bg-paper px-2 py-0.5 font-mono text-[10px] text-subdued border border-hairline">
                {t.adapterBadge}
              </span>
            </div>

            <h3 class="mt-5 font-display text-2xl font-semibold text-ink-strong">
              {plugin.name}
            </h3>

            <p class="mt-3 text-sm text-subdued-strong leading-relaxed">
              {plugin.desc}
            </p>

            <div class="mt-4 flex items-center gap-2 font-mono text-xs text-subdued">
              <span class="opacity-60">Triggers:</span>
              <span class="text-ink-strong">{plugin.triggers}</span>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-hairline">
            <div class="rounded border border-hairline bg-paper p-3 font-mono text-xs text-ink-strong flex items-center justify-between">
              <code class="text-accent">{plugin.code}</code>
              <span class="font-mono text-[10px] text-subdued flex-none ml-2">{t.codeBadge}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* Custom Plugin Colophon Strip */}
    <div class="mt-8 rounded-xl border border-hairline bg-paper/60 p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <span class="font-display text-sm font-semibold text-ink-strong block">
          {t.customPluginTitle}
        </span>
        <p class="text-xs sm:text-sm text-subdued-strong mt-0.5 max-w-[42rem]">
          {t.customPluginDesc}
        </p>
      </div>
      <a class="font-mono text-xs text-accent hover:underline flex-none" href={`/${lang}/docs/concepts/components-architecture`}>
        openpress-plugins docs &rarr;
      </a>
    </div>
  </div>
</section>
