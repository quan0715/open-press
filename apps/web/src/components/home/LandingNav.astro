---
import LogoMark from "./LogoMark.astro";
import { getRelativeLocaleUrl } from "astro:i18n";

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  links: NavLink[];
}

const { links } = Astro.props;
const currentLocale = Astro.currentLocale || "zh-tw";
const primaryLinks = links.filter((link) => link.label !== "Star" && link.label !== "npm");
const actionLinks = links.filter((link) => link.label === "Star" || link.label === "npm");
const getPath = (href: string) => {
  if (href.startsWith("http")) return href;
  let p = href.replace(/^\//, "");
  let relUrl = getRelativeLocaleUrl(currentLocale, p);
  return relUrl.endsWith("/") && relUrl !== "/" ? relUrl.slice(0, -1) : relUrl;
};

const getLangUrl = (targetLang: string) => {
  const currentPath = Astro.url.pathname;
  const segments = currentPath.split("/").filter(Boolean);
  if (["zh-tw", "en", "ja"].includes(segments[0])) {
    segments[0] = targetLang;
  } else {
    segments.unshift(targetLang);
  }
  const newPath = "/" + segments.join("/");
  return newPath.endsWith("/") && newPath !== "/" ? newPath.slice(0, -1) : newPath;
};
---

<header class="sticky top-0 z-20 border-b border-hairline bg-[color-mix(in_srgb,var(--op-paper)_90%,transparent)] backdrop-blur-[18px]" data-landing-nav>
  <div class="op-page flex min-h-16 items-center justify-between gap-6">
    <a class="text-ink-strong no-underline" href={getRelativeLocaleUrl(currentLocale, "")} aria-label="OpenPress home">
      <LogoMark />
    </a>

    <nav class="flex flex-nowrap items-center justify-end gap-2 font-body text-sm font-medium" aria-label="Primary navigation">
      <div class="flex items-center gap-1 max-[820px]:hidden">
        {primaryLinks.map((link) => {
          const path = getPath(link.href);
          const active = Astro.url.pathname.startsWith(path);
          return (
            <a class:list={["rounded-md px-3 py-2 text-ink no-underline transition-colors hover:bg-paper-soft hover:text-ink-strong", active && "bg-paper-soft font-semibold text-ink-strong"]} href={path} aria-current={active ? "page" : undefined}>
              {link.label}
            </a>
          );
        })}
      </div>

      {actionLinks.map((link) => link.label === "Star" ? (
        <a class="inline-flex min-h-9 items-center gap-2 rounded-md border border-hairline-strong bg-surface px-3 py-1.5 text-ink-strong no-underline transition-[border-color,color,transform] hover:border-accent hover:text-accent active:translate-y-px" href={getPath(link.href)} data-github-star-link aria-label="Star OpenPress on GitHub, 5 stars">
          <span>GitHub</span>
          <strong class="font-mono text-[0.72rem] font-medium text-subdued-strong" data-github-stars aria-label="5 GitHub stars">5</strong>
        </a>
      ) : (
        <a class="inline-flex min-h-9 items-center gap-2 px-2 py-1.5 font-mono text-[0.72rem] text-subdued no-underline transition-colors hover:text-accent max-[1040px]:hidden" href={getPath(link.href)} aria-label="Open @open-press/cli on npm">
          <span>npm</span>
          <strong class="font-medium" data-npm-downloads>1.4k/mo</strong>
        </a>
      ))}

      <div class="ml-2 flex items-center gap-1 border-l border-hairline pl-2 max-[520px]:hidden">
        <a href={getLangUrl("zh-tw")} class:list={["rounded px-1.5 py-1 text-[0.72rem] text-subdued no-underline transition-colors hover:text-ink-strong", currentLocale === "zh-tw" && "font-semibold text-ink-strong"]}>繁</a>
        <a href={getLangUrl("en")} class:list={["rounded px-1.5 py-1 text-[0.72rem] text-subdued no-underline transition-colors hover:text-ink-strong", currentLocale === "en" && "font-semibold text-ink-strong"]}>EN</a>
        <a href={getLangUrl("ja")} class:list={["rounded px-1.5 py-1 text-[0.72rem] text-subdued no-underline transition-colors hover:text-ink-strong", currentLocale === "ja" && "font-semibold text-ink-strong"]}>日</a>
      </div>

      <button class="ml-1 grid h-9 w-9 cursor-pointer place-items-center rounded-md border border-hairline-strong bg-surface text-ink transition-[border-color,transform] hover:border-accent active:translate-y-px" id="theme-toggle" aria-label="Toggle dark mode">
        <span class="h-3.5 w-3.5 rounded-full border border-current bg-[linear-gradient(90deg,currentColor_50%,transparent_50%)]" aria-hidden="true"></span>
      </button>
    </nav>
  </div>
</header>

<script>
  const starCounter = document.querySelector("[data-github-stars]");
  const starLink = document.querySelector("[data-github-star-link]");
  const downloadsCounter = document.querySelector("[data-npm-downloads]");
  const formatCompactCount = (count: number) => {
    if (count >= 1000000) return `${(count / 1000000).toFixed(1)}m`;
    if (count >= 1000) return `${(count / 1000).toFixed(1)}k`;
    return String(count);
  };

  const formatDownloads = (downloads: number) => {
    return `${formatCompactCount(downloads)}/mo`;
  };

  if (starCounter instanceof HTMLElement) {
    fetch("https://api.github.com/repos/quan0715/open-press")
      .then((response) => (response.ok ? response.json() : null))
      .then((data: { stargazers_count?: number } | null) => {
        if (typeof data?.stargazers_count === "number") {
          const starText = formatCompactCount(data.stargazers_count);
          starCounter.textContent = starText;
          starCounter.setAttribute("aria-label", `${data.stargazers_count} GitHub stars`);
          starLink?.setAttribute("aria-label", `Star OpenPress on GitHub, ${data.stargazers_count} stars`);
        }
      })
      .catch(() => {
        // Keep the static fallback when GitHub's API is unavailable.
      });
  }

  if (downloadsCounter instanceof HTMLElement) {
    fetch("https://api.npmjs.org/downloads/point/last-month/@open-press/cli")
      .then((response) => (response.ok ? response.json() : null))
      .then((data: { downloads?: number } | null) => {
        if (typeof data?.downloads === "number") {
          downloadsCounter.textContent = formatDownloads(data.downloads);
        }
      })
      .catch(() => {
        // Keep the static fallback when npm's API is unavailable.
      });
  }

  const themeToggle = document.getElementById("theme-toggle");
  if (themeToggle) {
    themeToggle.addEventListener("click", () => {
      const isDark = document.documentElement.getAttribute("data-theme") === "dark";
      if (isDark) {
        document.documentElement.removeAttribute("data-theme");
        localStorage.setItem("op-theme", "light");
      } else {
        document.documentElement.setAttribute("data-theme", "dark");
        localStorage.setItem("op-theme", "dark");
      }
    });
  }
</script>
