        layoutState: "neutral",
        tokens: "膨大（タグの肥大化）",
        tokensState: "bad",
        humanEdit: "困難（タグのノイズが多い）",
        humanEditState: "bad",
        bestFor: "Web サイト、単一ページ",
        isHero: false,
      },
      {
        name: "OpenPress",
        tag: "MDX + 固定組版エンジン",
        badge: "AI 出版標準",
        speed: "速い",
        speedState: "good",
        layout: "最高峰 300DPI（固定紙面）",
        layoutState: "good",
        tokens: "極小（HTML 比 3〜5 倍節約）",
        tokensState: "good",
        humanEdit: "極めて容易（MDX 直修 + プレビュー）",
        humanEditState: "good",
        bestFor: "白書、公式報告書、企画提案書",
        isHero: true,
      },
    ],
    calloutText: "AI に肥大化する HTML を書かせる必要はありません。人間が直感的に編集できる軽量 MDX で、300DPI 印刷級の出版物と安全な提案レビューを実現します。",
    ctaText: "今すぐ始める",
  },
} as const;

const t = copy[lang as keyof typeof copy] || copy["zh-tw"];
---

<section class="relative border-b border-hairline py-20 lg:py-28 bg-paper/40" aria-labelledby="why-title">
  {/* Registration cross marks */}
  <div class="pointer-events-none absolute left-6 top-6 font-mono text-xs text-subdued/40 select-none max-sm:hidden">+ 02.00</div>
  <div class="pointer-events-none absolute right-6 top-6 font-mono text-xs text-subdued/40 select-none max-sm:hidden">+ 98.00</div>

  <div class="op-page">
    <div class="max-w-[48rem]">
      <div class="flex items-center gap-2 text-accent font-mono text-xs uppercase tracking-widest">
        <span class="op-seal-stamp h-4 w-4 text-[9px] font-bold">{t.seal}</span>
        <span>{t.badge}</span>
      </div>
      <h2 id="why-title" class="mt-4 font-display text-[clamp(2.4rem,4.4vw,4.2rem)] font-medium leading-[1.02] tracking-[-0.04em] text-ink-strong">
        {t.title}
      </h2>
      <p class="mt-4 text-base lg:text-lg leading-[1.65] text-subdued-strong">
        {t.subtitle}
      </p>
    </div>

    {/* 4-Column Editorial Comparison Grid */}
    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {t.items.map((item, idx) => (
        <div class={`rounded-xl p-6 flex flex-col justify-between transition-all duration-200 relative ${
          item.isHero
            ? "border-2 border-accent/60 bg-surface shadow-[0_16px_40px_rgba(216,59,39,0.08)] ring-1 ring-accent/20"
            : "border border-hairline bg-surface/80 hover:bg-surface shadow-sm"
        }`}>
          <div>
            {/* Header / Brand */}
            <div class="border-b border-hairline pb-4">
              <div class="flex items-center justify-between">
                <span class={`font-display text-xl font-semibold tracking-tight ${item.isHero ? 'text-accent' : 'text-ink-strong'}`}>
                  {item.name}
                </span>
                {item.isHero ? (
                  <span class="rounded bg-accent text-white px-2 py-0.5 font-mono text-[9px] font-bold tracking-wider uppercase">
                    {item.badge}
                  </span>
                ) : (
                  <span class="font-mono text-[10px] text-subdued">
                    0{idx + 1}
                  </span>
                )}
              </div>
              <span class="font-mono text-[11px] text-subdued block mt-1">
                {item.tag}
              </span>
            </div>

            {/* Spec Matrix List */}
            <div class="mt-5 space-y-4 text-xs">
              {/* Speed */}
              <div>
                <span class="font-mono text-[10px] text-subdued uppercase tracking-wider block mb-0.5">
                  {t.labels.speed}
                </span>
                <span class={`font-body font-medium flex items-center gap-1.5 ${
                  item.speedState === 'good' ? 'text-emerald-700 dark:text-emerald-400 font-semibold' :
                  item.speedState === 'warn' ? 'text-rose-700 dark:text-rose-400' : 'text-ink-strong'
                }`}>
                  <span class={`h-1.5 w-1.5 rounded-full ${
                    item.speedState === 'good' ? 'bg-emerald-500' :
                    item.speedState === 'warn' ? 'bg-rose-500' : 'bg-subdued'
                  }`}></span>
                  {item.speed}
                </span>
              </div>

              {/* Layout Aesthetics */}
              <div>
                <span class="font-mono text-[10px] text-subdued uppercase tracking-wider block mb-0.5">
                  {t.labels.layout}
                </span>
                <span class={`font-body font-medium flex items-center gap-1.5 ${
                  item.layoutState === 'good' ? 'text-accent font-semibold' : 'text-ink-strong'
                }`}>
                  <span class={`h-1.5 w-1.5 rounded-full ${
                    item.layoutState === 'good' ? 'bg-accent' :
                    item.layoutState === 'warn' ? 'bg-amber-500' : 'bg-subdued'
                  }`}></span>
                  {item.layout}
                </span>
              </div>

              {/* Token Cost */}
              <div>
                <span class="font-mono text-[10px] text-subdued uppercase tracking-wider block mb-0.5">
                  {t.labels.tokens}
                </span>
                <span class={`font-body font-medium flex items-center gap-1.5 ${
                  item.tokensState === 'good' ? 'text-emerald-700 dark:text-emerald-400 font-semibold' : 'text-rose-700 dark:text-rose-400'
                }`}>
                  <span class={`h-1.5 w-1.5 rounded-full ${
                    item.tokensState === 'good' ? 'bg-emerald-500' : 'bg-rose-500'
                  }`}></span>
                  {item.tokens}
                </span>
              </div>

              {/* Human Editability */}
              <div>
                <span class="font-mono text-[10px] text-subdued uppercase tracking-wider block mb-0.5">
                  {t.labels.humanEdit}
                </span>
                <span class={`font-body font-medium flex items-center gap-1.5 ${
                  item.humanEditState === 'good' ? 'text-ink font-semibold' : 'text-rose-700 dark:text-rose-400'
                }`}>
                  <span class={`h-1.5 w-1.5 rounded-full ${
                    item.humanEditState === 'good' ? 'bg-accent' : 'bg-rose-500'
                  }`}></span>
                  {item.humanEdit}
                </span>
              </div>
            </div>
          </div>

          {/* Best For Footer Pill */}
          <div class="mt-6 pt-4 border-t border-hairline">
            <span class="font-mono text-[9px] text-subdued uppercase tracking-wider block mb-1.5">
              {t.labels.bestFor}
            </span>
            <div class={`rounded px-2.5 py-1.5 text-xs font-medium ${
              item.isHero
                ? "bg-accent-soft text-accent border border-accent/20"
                : "bg-paper text-ink-strong border border-hairline"
            }`}>
              {item.bestFor}
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* Editorial Colophon Callout */}
    <div class="mt-10 rounded-xl border border-hairline-strong bg-surface p-6 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
      <div class="flex items-start sm:items-center gap-3.5">
        <span class="op-seal-stamp h-7 w-7 text-xs font-bold flex-none mt-0.5 sm:mt-0">壓</span>
        <p class="text-xs sm:text-sm text-subdued-strong leading-relaxed max-w-[46rem]">
          {t.calloutText}
        </p>
      </div>
      <a class="op-button op-button--primary text-xs py-2 px-4 flex-none" href={`/${lang}/docs/getting-started`}>
        {t.ctaText} &rarr;
      </a>
    </div>
  </div>
</section>
