        layoutState: "neutral",
        tokens: "極大（標籤不斷膨脹）",
        tokensState: "bad",
        humanEdit: "極難（滿滿標籤雜訊）",
        humanEditState: "bad",
        bestFor: "動態網站、單頁展示",
        isHero: false,
      },
      {
        name: "OpenPress",
        tag: "MDX + 固定版面引擎",
        badge: "AI 出版標準",
        speed: "極快",
        speedState: "good",
        layout: "極致 300DPI（固定紙張）",
        layoutState: "good",
        tokens: "極低（比 HTML 省 3~5 倍）",
        tokensState: "good",
        humanEdit: "極易（純 MDX + 雙向即時預覽）",
        humanEditState: "good",
        bestFor: "正式白皮書、報告、商業提案",
        isHero: true,
      },
    ],
    calloutText: "不強迫 AI 輸出膨脹失控的 HTML 標籤；以極低 Token 的精簡 MDX，讓人類能一眼看懂並手動修改，同時驅動 300DPI 印刷級分頁與沙盒審閱。",
    ctaText: "立即開始使用",
  },
  en: {
    badge: "AI PUBLISHING MATRIX",
    seal: "OP",
    title: "Why OpenPress?",
    subtitle: "Comparing 4 ways AI generates documents across speed, layout aesthetics, token consumption, and human editability.",
    labels: {
      speed: "Speed",
      layout: "Aesthetics",
      tokens: "Token Cost",
      humanEdit: "Human Editability",
      bestFor: "Best For",
    },
    items: [
      {
        name: "Markdown",
        tag: "Plain text stream",
        speed: "Ultra Fast",
        speedState: "good",
        layout: "Basic (No pagination)",
        layoutState: "warn",
        tokens: "Minimal (Pure text)",
        tokensState: "good",
        humanEdit: "Very Easy (Edit text directly)",
        humanEditState: "good",
        bestFor: "Internal notes, rough drafts",
        isHero: false,
      },
      {
        name: "Word (DOCX)",
        tag: "Script generation",
        speed: "Slow",
        speedState: "warn",
        layout: "Average (Rigid templates)",
        layoutState: "neutral",
        tokens: "High (Script overhead)",
        tokensState: "bad",
        humanEdit: "Easy (Edit directly in Word)",
        humanEditState: "good",
        bestFor: "Legacy corporate memos",
        isHero: false,
      },
      {
        name: "HTML",
        tag: "Web markup",
        speed: "Medium",
        speedState: "neutral",
        layout: "High (Cuts pages on print)",
        layoutState: "neutral",
        tokens: "Huge (Endless tag bloat)",
        tokensState: "bad",
        humanEdit: "Very Hard (Too much tag noise)",
        humanEditState: "bad",
        bestFor: "Websites, single-page UI",
        isHero: false,
      },
      {
        name: "OpenPress",
        tag: "MDX + Fixed-Page",
        badge: "AI STANDARD",
        speed: "Fast",
        speedState: "good",
        layout: "Print-Grade 300DPI",
        layoutState: "good",
        tokens: "Minimal (3x-5x less than HTML)",
        tokensState: "good",
        humanEdit: "Very Easy (Clean MDX + live preview)",
        humanEditState: "good",
        bestFor: "Whitepapers, reports, proposals",
        isHero: true,
      },
    ],
    calloutText: "Stop forcing AI to output bloated HTML markup. Leverage concise, token-efficient MDX that humans can effortlessly read and edit, while rendering 300DPI print-grade publications.",
    ctaText: "Get Started",
  },
  ja: {
    badge: "AI PUBLISHING MATRIX",
    seal: "辨",
    title: "なぜ OpenPress が必要なのか？",
    subtitle: "AI による文書生成の 4 方式を比較：生成速度・組版美・Token 消費・人間による編集性の最適解。",
    labels: {
      speed: "生成速度",
      layout: "組版と美しさ",
      tokens: "Token 消費",
      humanEdit: "人間の編集性",
      bestFor: "適用シーン",
    },
    items: [
      {
        name: "Markdown",
        tag: "プレーンテキスト",
        speed: "極めて速い",
