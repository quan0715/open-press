      layout: "美觀排版",
      tokens: "Token 消耗",
      humanEdit: "人工編輯性",
      bestFor: "適用場景",
    },
    items: [
      {
        name: "Markdown",
        tag: "純文字渲染",
        speed: "極快",
        speedState: "good",
        layout: "陽春（無分頁）",
        layoutState: "warn",
        tokens: "極低（純文字流）",
        tokensState: "good",
        humanEdit: "極易（純文字直接改）",
