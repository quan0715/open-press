---
import type { ShowcaseItem } from "../../data/showcases";

interface Props {
  lang: string;
  cases: ShowcaseItem[];
}

const { lang, cases } = Astro.props;
const initial = cases[0];
const ui = {
  "zh-tw": {
    title: "直接看成品。",
    desc: "六份由 OpenPress 完成的文件。先閱讀頁面，需要時再展開來源與提示詞。",
    cases: "選擇文件案例",
    pages: "頁",
    real: "真實專案",
    demo: "虛構示範資料",
    open: "開啟公開閱讀器",
    details: "來源與提示詞",
    audience: "適合誰",
    source: "來源素材",
    prompt: "使用的提示詞",
    copy: "複製提示詞",
    copied: "已複製",
    page: "頁面",
  },
  en: {
    title: "Start with the output.",
    desc: "Six documents completed with OpenPress. Read the pages first, then open the source and prompt when you need them.",
    cases: "Choose a document example",
    pages: "pages",
    real: "Real project",
    demo: "Fictional demo data",
    open: "Open public reader",
    details: "Source and prompt",
    audience: "Audience",
    source: "Source material",
    prompt: "Prompt used",
    copy: "Copy prompt",
    copied: "Copied",
    page: "Page",
  },
  ja: {
    title: "まず完成形を見る。",
    desc: "OpenPress で完成させた6つの文書です。先にページを読み、必要なときだけ素材とプロンプトを確認できます。",
    cases: "文書例を選択",
    pages: "ページ",
    real: "実際のプロジェクト",
    demo: "架空のデモデータ",
    open: "公開リーダーを開く",
    details: "素材とプロンプト",
    audience: "対象読者",
    source: "素材",
    prompt: "使用したプロンプト",
    copy: "プロンプトをコピー",
    copied: "コピーしました",
    page: "ページ",
  },
} as const;

const t = ui[lang as keyof typeof ui] ?? ui["zh-tw"];
const proofLabel = (proof: ShowcaseItem["proof"]) => proof === "real" ? t.real : t.demo;
---

<main id="main-content">
  <header class="border-b border-hairline py-[clamp(4rem,8vw,7rem)]" aria-labelledby="showcase-title">
    <div class="op-page">
      <h1 id="showcase-title" class="max-w-[13ch] text-[clamp(3.4rem,7vw,6.8rem)] font-medium leading-[0.94] tracking-[-0.055em] text-balance">{t.title}</h1>
      <p class="mt-7 max-w-[42rem] text-[clamp(1.05rem,1.4vw,1.25rem)] leading-[1.62] text-subdued-strong text-pretty">{t.desc}</p>
    </div>
  </header>

  <section class="border-b border-hairline py-8" aria-label={t.cases}>
    <div class="op-page overflow-x-auto pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <div class="flex min-w-max gap-4" role="tablist" aria-label={t.cases}>
        {cases.map((item, index) => (
          <button
            type="button"
            role="tab"
            class="group grid w-[10.5rem] cursor-pointer grid-cols-[3.15rem_1fr] items-center gap-3 rounded-md border border-transparent bg-transparent p-2 text-left text-ink transition-[background-color,border-color,transform] hover:bg-paper-soft active:translate-y-px focus-visible:outline-2 focus-visible:outline-accent aria-selected:border-hairline-strong aria-selected:bg-surface"
            data-showcase-tab={item.slug}
            aria-selected={index === 0 ? "true" : "false"}
          >
            <img class="aspect-[794/1123] w-full border border-hairline-strong bg-white object-cover" src={item.cover} alt="" loading="eager" decoding="async" />
            <span class="text-sm font-semibold leading-[1.25] text-ink-strong">{item.title}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <article class="pb-[clamp(5rem,9vw,8rem)] pt-[clamp(3.5rem,6vw,5.5rem)]" aria-live="polite">
    <div class="op-page">
      <div class="grid grid-cols-12 items-end gap-8 max-[820px]:grid-cols-1">
        <div class="col-span-8 max-[820px]:col-span-1">
          <p id="showcase-document-type" class="font-mono text-xs font-semibold text-accent">{initial.documentType}</p>
          <h2 id="showcase-document-title" class="mt-3 max-w-[20ch] text-[clamp(2.6rem,5.4vw,5.2rem)] font-medium leading-[0.98] tracking-[-0.045em] text-balance">{initial.title}</h2>
          <p id="showcase-document-description" class="mt-5 max-w-[45rem] text-lg leading-[1.6] text-subdued-strong">{initial.description}</p>
        </div>
        <div class="col-start-10 col-span-3 grid justify-items-end gap-4 max-[820px]:col-start-1 max-[820px]:col-span-1 max-[820px]:justify-items-start">
          <a id="showcase-live-link" class:list={["op-button op-button--primary", !initial.href && "hidden"]} href={initial.href} target="_blank" rel="noreferrer">{t.open}</a>
          <p class="font-mono text-[0.72rem] text-subdued" id="showcase-meta">
            <span id="showcase-page-count">{initial.pageCount} {t.pages}</span>
            <span class="mx-2 text-hairline-strong" aria-hidden="true">/</span>
            <span id="showcase-proof">{proofLabel(initial.proof)}</span>
          </p>
        </div>
      </div>
    </div>

    <div class="mt-12 border-y border-hairline bg-paper-soft py-[clamp(2rem,5vw,5rem)]">
      <div class="flex snap-x snap-mandatory items-start gap-[clamp(1.5rem,4vw,4rem)] overflow-x-auto px-[max(1.5rem,calc((100vw-86rem)/2))] pb-6 [scrollbar-color:var(--op-accent)_transparent]" id="showcase-pages" tabindex="0">
        {initial.pages.map((page, index) => (
          <figure class="m-0 w-[min(78vw,47rem)] flex-none snap-center">
            <img src={page} alt={`${initial.title} - ${t.page} ${index + 1}`} class="op-paper-image w-full" loading="eager" decoding="async" />
          </figure>
        ))}
      </div>
    </div>

    <div class="op-page mt-10">
      <details class="group max-w-[68rem] border-t border-hairline">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-lg font-semibold text-ink-strong focus-visible:outline-2 focus-visible:outline-accent [&::-webkit-details-marker]:hidden">
          <span>{t.details}</span>
          <span class="font-mono text-xl font-normal transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <div class="grid gap-10 border-t border-hairline pb-4 pt-8 md:grid-cols-[0.8fr_1.2fr] md:gap-x-16">
          <dl class="m-0 grid content-start gap-8">
            <div>
              <dt class="font-mono text-xs font-semibold text-subdued">{t.audience}</dt>
              <dd id="showcase-audience" class="m-0 mt-2 leading-[1.6] text-ink">{initial.audience}</dd>
            </div>
            <div>
              <dt class="font-mono text-xs font-semibold text-subdued">{t.source}</dt>
              <dd id="showcase-source" class="m-0 mt-2 leading-[1.6] text-ink">{initial.sourceMaterial}</dd>
            </div>
          </dl>
          <div>
            <div class="flex items-center justify-between gap-4">
              <p class="m-0 font-mono text-xs font-semibold text-subdued">{t.prompt}</p>
              <button id="showcase-copy-prompt" type="button" class="cursor-pointer border-0 bg-transparent p-0 text-sm font-semibold text-ink-strong underline decoration-1 underline-offset-4 hover:text-accent focus-visible:outline-2 focus-visible:outline-accent" data-copy-label={t.copy} data-copied-label={t.copied}>{t.copy}</button>
            </div>
            <p id="showcase-prompt" class="mt-4 max-w-[46rem] whitespace-pre-wrap text-[1.05rem] leading-[1.68] text-subdued-strong">{initial.prompt}</p>
          </div>
        </div>
      </details>
    </div>
  </article>

  <script id="showcase-data" type="application/json" is:inline set:html={JSON.stringify(cases)} />
  <script id="showcase-ui" type="application/json" is:inline set:html={JSON.stringify({ pages: t.pages, page: t.page, real: t.real, demo: t.demo })} />
</main>

<script is:inline>
  const showcaseItems = JSON.parse(document.querySelector("#showcase-data")?.textContent ?? "[]");
  const showcaseUi = JSON.parse(document.querySelector("#showcase-ui")?.textContent ?? "{}");
  const showcaseTabs = Array.from(document.querySelectorAll("[data-showcase-tab]"));
  const pagesStage = document.querySelector("#showcase-pages");
  const typeNode = document.querySelector("#showcase-document-type");
  const titleNode = document.querySelector("#showcase-document-title");
  const descriptionNode = document.querySelector("#showcase-document-description");
  const pageCountNode = document.querySelector("#showcase-page-count");
  const proofNode = document.querySelector("#showcase-proof");
  const audienceNode = document.querySelector("#showcase-audience");
  const sourceNode = document.querySelector("#showcase-source");
  const promptNode = document.querySelector("#showcase-prompt");
  const liveLink = document.querySelector("#showcase-live-link");
  const copyPrompt = document.querySelector("#showcase-copy-prompt");
  let activeItem = showcaseItems[0];

  const setText = (node, value) => { if (node) node.textContent = value; };
  const renderPages = (item) => {
    if (!pagesStage) return;
    pagesStage.replaceChildren(...item.pages.map((src, index) => {
      const figure = document.createElement("figure");
      figure.className = "m-0 w-[min(78vw,47rem)] flex-none snap-center";
      const image = document.createElement("img");
      image.src = src;
      image.alt = `${item.title} - ${showcaseUi.page} ${index + 1}`;
      image.loading = "eager";
      image.decoding = "async";
      image.className = "op-paper-image w-full";
      figure.append(image);
      return figure;
    }));
    pagesStage.scrollTo({ left: 0, behavior: "instant" });
  };

  const activateShowcase = (slug, updateHash = true) => {
    const item = showcaseItems.find((entry) => entry.slug === slug) ?? showcaseItems[0];
    if (!item) return;
    activeItem = item;
    showcaseTabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.showcaseTab === item.slug)));
    showcaseTabs.find((tab) => tab.dataset.showcaseTab === item.slug)?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
    setText(typeNode, item.documentType);
    setText(titleNode, item.title);
    setText(descriptionNode, item.description);
    setText(pageCountNode, `${item.pageCount} ${showcaseUi.pages}`);
    setText(proofNode, item.proof === "real" ? showcaseUi.real : showcaseUi.demo);
    setText(audienceNode, item.audience);
    setText(sourceNode, item.sourceMaterial);
    setText(promptNode, item.prompt);
    if (liveLink) {
      liveLink.classList.toggle("hidden", !item.href);
      if (item.href) liveLink.href = item.href;
    }
    renderPages(item);
    if (updateHash && location.hash.slice(1) !== item.slug) history.replaceState(null, "", `#${item.slug}`);
  };

  showcaseTabs.forEach((tab) => tab.addEventListener("click", () => activateShowcase(tab.dataset.showcaseTab)));
  copyPrompt?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(activeItem?.prompt ?? "");
      copyPrompt.textContent = copyPrompt.dataset.copiedLabel ?? "Copied";
      window.setTimeout(() => { copyPrompt.textContent = copyPrompt.dataset.copyLabel ?? "Copy"; }, 1400);
    } catch {
      copyPrompt.textContent = copyPrompt.dataset.copyLabel ?? "Copy";
    }
  });

  const hashSlug = location.hash.slice(1);
  if (hashSlug) activateShowcase(hashSlug, false);
  window.addEventListener("hashchange", () => activateShowcase(location.hash.slice(1), false));
</script>
