{
  "version": 1,
  "appearance": {
    "colorMode": "light",
    "accent": "blue"
  },
  "page": "a4",
  "captionNumbering": {
    "figure": "Figure",
    "table": "Table",
    "separator": " "
  },
  "pdf": {
    "filename": "openpress-user-story-book.pdf"
  },
  "deploy": {
    "adapter": "cloudflare-pages",
    "source": ".deploy/story",
    "projectName": "open-press-story",
    "commitDirty": false,
    "requiresConfirmation": true,
    "presses": {
      "userstory": {
        "source": ".deploy/userstory",
        "projectName": "open-press-story"
      },
      "resume": {
        "source": ".deploy/resume",
        "projectName": "open-press-resume"
      },
      "school-report": {
        "source": ".deploy/school-report",
        "projectName": "open-press-school-report"
      },
      "financial-report": {
        "source": ".deploy/financial-report",
        "projectName": "open-press-financial-report"
      },
      "thesis": {
        "source": ".deploy/thesis",
        "projectName": "open-press-thesis"
      }
    }
  },
  "plugins": {
    "diagram-design": {
      "enabled": true,
      "version": "^1.0.0",
      "source": "quan0715/diagram-design"
    },
    "gc-minimal-zine-poster": {
      "enabled": true,
      "version": "^0.3.1",
      "source": "LiamGvchi/gc-minimal-zine-poster"
    }
  }
}
